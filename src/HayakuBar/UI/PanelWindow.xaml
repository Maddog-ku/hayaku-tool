<Window x:Class="HayakuBar.UI.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HayakuBar"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Width="392" SizeToContent="Height"
        FontFamily="{StaticResource UiFont}" FontSize="12"
        Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="TaskRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" ToolTip="{Binding IconTip}"
                           VerticalAlignment="Center" FontSize="11" />
                <TextBlock Grid.Column="1" Text="{Binding Key}" FontWeight="SemiBold" Margin="0,0,6,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Title}" ToolTip="{Binding Title}"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Elapsed}" FontFamily="{StaticResource MonoFont}"
                           Margin="6,0,2,0" VerticalAlignment="Center" />
                <Button Grid.Column="4" Content="{Binding ActionGlyph}" ToolTip="{Binding ActionTip}"
                        Tag="{Binding}" Click="TaskAction_Click" Style="{StaticResource IconButton}"
                        FontSize="10" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RepoRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                           Margin="8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding TaskText}" ToolTip="{Binding TaskTip}"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="選擇" Tag="{Binding}" Click="RepoPick_Click"
                        Visibility="{Binding PickVisibility}" Style="{StaticResource IconButton}"
                        Margin="4,0,0,0" ToolTip="為這個 repo 目前的 Claude session 指定任務" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="8" Padding="14,12,14,10" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" />
        </Border.Effect>
        <StackPanel>
            <Grid>
                <TextBlock x:Name="UserText" FontWeight="SemiBold" FontSize="13" Text="Hayaku" />
                <TextBlock x:Name="StatusText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>

            <StackPanel x:Name="SummaryRow" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="TotalText" FontSize="22" FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}" />
                <TextBlock x:Name="ExpectedText" FontSize="22" Foreground="{StaticResource MutedBrush}"
                           FontFamily="{StaticResource MonoFont}" />
                <Grid Width="90" Height="5" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border Background="{StaticResource LineBrush}" CornerRadius="2.5" />
                    <Border x:Name="ProgressFill" Background="{StaticResource AccentBrush}" CornerRadius="2.5"
                            HorizontalAlignment="Left" Width="0" />
                </Grid>
                <TextBlock x:Name="SummaryDetail" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                       Margin="0,6,0,0" Visibility="Collapsed" />

            <Button x:Name="LoginButton" Content="登入 Hayaku" Style="{StaticResource PrimaryButton}"
                    Margin="0,10,0,4" Padding="12,6" Click="Login_Click" Visibility="Collapsed" />
            <TextBlock x:Name="LoginHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                       Visibility="Collapsed"
                       Text="會開啟瀏覽器到 Hayaku 登入並授權，之後這個工具會出現在「我的 › 已連線的應用程式」。" />

            <StackPanel x:Name="MainContent">
                <TextBlock Text="計時中" Style="{StaticResource SectionTitle}" />
                <ItemsControl x:Name="RunningList" ItemTemplate="{StaticResource TaskRowTemplate}" />
                <TextBlock x:Name="RunningEmpty" Text="目前沒有計時" Foreground="{StaticResource MutedBrush}" />

                <StackPanel x:Name="PausedSection">
                    <TextBlock Text="今天做過" Style="{StaticResource SectionTitle}" />
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PausedList" ItemTemplate="{StaticResource TaskRowTemplate}" />
                    </ScrollViewer>
                </StackPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="TaskCombo" IsEditable="True" IsTextSearchEnabled="True"
                              ToolTip="輸入或選擇任務編號（例 F2P-97）" />
                    <Button Grid.Column="1" Content="開始" Margin="6,0,0,0" Style="{StaticResource FlatButton}"
                            Click="StartTask_Click" />
                </Grid>

                <StackPanel x:Name="ClaudeSection">
                    <TextBlock Text="Claude Code" Style="{StaticResource SectionTitle}" />
                    <ItemsControl x:Name="RepoList" ItemTemplate="{StaticResource RepoRowTemplate}" />
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ClockInButton" Content="上班" Style="{StaticResource PrimaryButton}"
                            Click="ClockIn_Click" ToolTip="恢復上次的任務並開始計時" />
                    <Button x:Name="ClockOutButton" Content="下班" Style="{StaticResource FlatButton}"
                            Margin="6,0,0,0" Click="ClockOut_Click" ToolTip="停止所有計時，今天不再自動上班" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="⟳" Style="{StaticResource IconButton}" FontSize="14" ToolTip="立即同步"
                            Click="Refresh_Click" />
                    <Button Content="⚙" Style="{StaticResource IconButton}" FontSize="14" ToolTip="設定"
                            Click="Settings_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
