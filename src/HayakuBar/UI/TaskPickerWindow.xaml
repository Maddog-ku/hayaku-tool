<Window x:Class="HayakuBar.UI.TaskPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="選擇任務" Width="480" Height="520" Icon="/Assets/app.ico" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock x:Name="PromptText" DockPanel.Dock="Top" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,4"
                   Text="搜尋，或直接輸入任務編號（例 F2P-97）" />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Padding="4,3" Margin="0,0,0,8"
                 TextChanged="SearchBox_TextChanged" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="確定" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="16,5"
                    Click="Ok_Click" />
            <Button Content="取消" IsCancel="True" Style="{StaticResource FlatButton}" Padding="16,5" Margin="8,0,0,0" />
        </StackPanel>
        <ListBox x:Name="TaskList" MouseDoubleClick="TaskList_MouseDoubleClick" BorderBrush="{DynamicResource LineBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock>
                            <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="{Binding Title, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
