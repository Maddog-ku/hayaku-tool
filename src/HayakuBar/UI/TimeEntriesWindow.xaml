<Window x:Class="HayakuBar.UI.TimeEntriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工時紀錄" Width="760" Height="640" MinWidth="620" MinHeight="460" Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource SubtleBrush}" Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="64" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        </Style>

        <DataTemplate x:Key="EntryRow">
            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                               ToolTip="{Binding Title}">
                        <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                    </TextBlock>
                    <TextBox Grid.Column="2" Style="{StaticResource TimeBox}" Text="{Binding StartText, UpdateSourceTrigger=LostFocus}"
                             KeyDown="CommitOnEnter" ToolTip="開始時間（HH:mm）" />
                    <TextBlock Grid.Column="3" Text="–" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <Grid Grid.Column="4">
                        <TextBox Style="{StaticResource TimeBox}" Text="{Binding EndText, UpdateSourceTrigger=LostFocus}"
                                 KeyDown="CommitOnEnter" ToolTip="結束時間（HH:mm）" Visibility="{Binding EndVisibility}" />
                        <TextBlock Text="進行中" Width="64" TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource RunBrush}" Visibility="{Binding RunningVisibility}" />
                    </Grid>
                    <TextBlock Grid.Column="5" Text="{Binding DurationText}" Width="64" TextAlignment="Right" Margin="0,0,12,0"
                               VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" />
                    <TextBox Grid.Column="6" Text="{Binding Note, UpdateSourceTrigger=LostFocus}" KeyDown="CommitOnEnter"
                             ToolTip="備註" Margin="0,0,8,0" />
                    <Button Grid.Column="7" Content="刪除" Style="{StaticResource IconButton}" Tag="{Binding}"
                            Click="Delete_Click" ToolTip="刪除這段紀錄" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <!-- 日期與合計 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="‹" Style="{StaticResource FlatButton}" FontSize="15" Padding="10,2" Click="PrevDay_Click" ToolTip="前一天" />
                <TextBlock x:Name="DateText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                <Button Content="›" Style="{StaticResource FlatButton}" FontSize="15" Padding="10,2" Click="NextDay_Click" ToolTip="後一天" />
                <Button x:Name="TodayButton" Content="今天" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="Today_Click" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TotalText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock x:Name="ScheduleText" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- 補登 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="補登" FontWeight="SemiBold" />
                <WrapPanel x:Name="GapsPanel" Margin="0,6,0,0" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="NewTask" IsEditable="True" IsTextSearchEnabled="False" Margin="0,0,8,0"
                              ToolTip="任務編號，例 F2P-97（可直接輸入）" />
                    <TextBox x:Name="NewStart" Grid.Column="1" Style="{StaticResource TimeBox}" ToolTip="開始（HH:mm）" />
                    <TextBlock Grid.Column="2" Text="–" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                    <TextBox x:Name="NewEnd" Grid.Column="3" Style="{StaticResource TimeBox}" ToolTip="結束（HH:mm）" Margin="0,0,8,0" />
                    <TextBox x:Name="NewNote" Grid.Column="4" ToolTip="備註（選填）" Margin="0,0,8,0" />
                    <Button Grid.Column="5" Content="新增" Style="{StaticResource PrimaryButton}" Padding="16,5" Click="Add_Click" IsDefault="False" />
                </Grid>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EntryList" ItemTemplate="{StaticResource EntryRow}" />
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Text="這天沒有計時紀錄" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="LoadingText" Text="讀取中…" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
