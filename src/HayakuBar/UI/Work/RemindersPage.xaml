<UserControl x:Class="HayakuBar.UI.Work.RemindersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,18,24,16">
        <TextBlock DockPanel.Dock="Top" Text="提醒" Style="{StaticResource PageTitle}" />

        <!-- 新增 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="新增提醒" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="內容" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="MessageInput" Style="{StaticResource HintBox}" Tag="要提醒什麼" KeyDown="Form_KeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="日期" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DateBox" Style="{StaticResource HintBox}" Tag="今天、明天、11/5" KeyDown="Form_KeyDown" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="時間" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TimeBox" Style="{StaticResource HintBox}" Tag="HH:mm" KeyDown="Form_KeyDown"
                                 FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="綁任務（選填）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TaskBox" Style="{StaticResource HintBox}" Tag="例 F2P-97" KeyDown="Form_KeyDown" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="重複" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="RepeatBox" Width="170" SelectedIndex="0">
                            <ComboBoxItem Content="不重複" Tag="none" />
                            <ComboBoxItem Content="每天" Tag="daily" />
                            <ComboBoxItem Content="每個工作日" Tag="workdays" />
                            <ComboBoxItem Content="每週（同一個星期幾）" Tag="weekly" />
                            <ComboBoxItem Content="每月（同一天）" Tag="monthly" />
                        </ComboBox>
                        <StackPanel x:Name="QuickPanel" Orientation="Horizontal" Margin="16,0,0,0">
                            <TextBlock Text="快速：" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                            <Button Content="30 分鐘後" Style="{StaticResource LinkButton}" Margin="4,0,10,0" Tag="30" Click="Quick_Click" />
                            <Button Content="1 小時後" Style="{StaticResource LinkButton}" Margin="0,0,10,0" Tag="60" Click="Quick_Click" />
                            <Button Content="明天上班" Style="{StaticResource LinkButton}" Margin="0,0,10,0" Tag="tomorrow" Click="Quick_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="AddButton" Content="新增" Style="{StaticResource PrimaryButton}" Padding="18,6" HorizontalAlignment="Right"
                            Click="Add_Click" />
                </Grid>
                <TextBlock x:Name="FormStatus" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border Style="{StaticResource SegmentTrack}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="UpcomingTab" Style="{StaticResource Segment}" GroupName="RemTab" Tag="upcoming" Content="即將到來"
                                 IsChecked="True" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="RemTab" Tag="fired" Content="已提醒" Checked="Tab_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="RemTab" Tag="repeat" Content="重複" Checked="Tab_Checked" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="FilterText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
        </Grid>
        <TextBlock x:Name="ListStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ReminderList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding When}" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                                               Foreground="{Binding WhenBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDesc}" Visibility="{Binding DetailVisibility}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="延後 10 分" Style="{StaticResource IconButton}" Tag="{Binding}" Click="Snooze_Click"
                                                Visibility="{Binding SnoozeVisibility}" />
                                        <Button Content="{Binding PauseText}" Style="{StaticResource IconButton}" Tag="{Binding}" Click="Pause_Click"
                                                Visibility="{Binding PauseVisibility}" Margin="6,0,0,0" />
                                        <Button Content="開啟任務" Style="{StaticResource IconButton}" Tag="{Binding}" Click="OpenTask_Click"
                                                Visibility="{Binding TaskVisibility}" Margin="6,0,0,0" />
                                        <Button Content="刪除" Style="{StaticResource IconButton}" Tag="{Binding}" Click="Delete_Click"
                                                Visibility="{Binding DeleteVisibility}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
