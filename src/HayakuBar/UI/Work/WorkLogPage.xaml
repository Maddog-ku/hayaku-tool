<UserControl x:Class="HayakuBar.UI.Work.WorkLogPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,18,24,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="工作日誌" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="‹" Style="{StaticResource FlatButton}" FontSize="15" Padding="10,2" Click="Prev_Click" ToolTip="前一天" />
                <TextBlock x:Name="DateText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" MinWidth="110"
                           TextAlignment="Center" />
                <Button Content="›" Style="{StaticResource FlatButton}" FontSize="15" Padding="10,2" Click="Next_Click" ToolTip="後一天" />
                <Button x:Name="TodayButton" Content="今天" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="Today_Click" />
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TotalText" FontSize="22" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock Text="照計時紀錄整理；同時計時的時間各任務都會算" Style="{StaticResource CardDesc}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="DraftButton" Content="✦ Claude 整理" Style="{StaticResource PrimaryButton}" Padding="12,5"
                            Margin="0,0,6,0" Click="Draft_Click"
                            ToolTip="把這天的 Claude Code 對話與 commit 整理成日誌草稿，也能寫進計時段的備註" />
                    <Button x:Name="CopyButton" Content="複製成文字" Style="{StaticResource FlatButton}" Padding="12,5" Click="Copy_Click"
                            ToolTip="複製成「任務 時數」清單，貼到日報" />
                    <Button Content="工時紀錄" Style="{StaticResource FlatButton}" Padding="12,5" Margin="6,0,0,0" Click="Entries_Click"
                            ToolTip="查看、修改、補登這天的計時" />
                    <Button Content="在網頁寫日誌 ↗" Style="{StaticResource FlatButton}" Padding="12,5" Margin="6,0,0,0" Click="Web_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Visibility="Collapsed" Margin="2,0,0,8" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel x:Name="DraftSection" Visibility="Collapsed" Margin="0,0,0,6">
                    <Grid>
                        <TextBlock Text="Claude 整理的草稿" Style="{StaticResource GroupLabel}" />
                        <Button Content="收起" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Click="CloseDraft_Click" Margin="0,0,0,6" />
                    </Grid>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="DraftInfo" Style="{StaticResource CardDesc}" Margin="0,0,0,8" TextWrapping="Wrap" />
                            <TextBox x:Name="DraftBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="360"
                                     VerticalScrollBarVisibility="Auto" Padding="8,6" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="複製" Style="{StaticResource FlatButton}" Padding="12,5" Margin="0,0,6,0"
                                        Click="CopyDraft_Click" />
                                <Button x:Name="CaptureDraftButton" Content="存到隨手記" Style="{StaticResource FlatButton}" Padding="12,5"
                                        Margin="0,0,6,0" Click="CaptureDraft_Click" ToolTip="把上面的草稿（可以先改）存到 Hayaku 的隨手記" />
                                <Button x:Name="NotesButton" Style="{StaticResource FlatButton}" Padding="12,5" Click="ApplyNotes_Click"
                                        ToolTip="只寫進還沒有備註的計時段，內容是那段時間裡同一個任務送出的指令與 commit" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ItemsControl x:Name="EntryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Task}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Ranges}" Style="{StaticResource CardDesc}" FontFamily="{StaticResource MonoFont}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Hours}" FontFamily="{StaticResource MonoFont}" FontSize="15"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="這天沒有計時紀錄" Foreground="{DynamicResource MutedBrush}" Margin="4,10"
                           Visibility="Collapsed" />
                <StackPanel x:Name="NoteSection" Visibility="Collapsed">
                    <TextBlock Text="我寫的日誌" Style="{StaticResource GroupLabel}" />
                    <Border Style="{StaticResource Card}">
                        <TextBox x:Name="NoteText" Style="{StaticResource PlainText}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
