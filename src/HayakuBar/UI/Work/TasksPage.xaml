<UserControl x:Class="HayakuBar.UI.Work.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="TaskRow">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="{Binding TimerGlyph}" ToolTip="{Binding TimerTip}" Tag="{Binding}" Click="RowTimer_Click"
                        Style="{StaticResource IconButton}" Foreground="{Binding TimerBrush}" FontSize="10"
                        VerticalAlignment="Top" Margin="-4,1,0,0" />
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="{Binding Title, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Context}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Visibility="{Binding StatusVisibility}">
                        <TextBlock Text="{Binding Status}" FontSize="11" />
                    </Border>
                    <TextBlock Text="{Binding DueText}" Foreground="{Binding DueBrush}" FontSize="11" HorizontalAlignment="Right"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChildRow">
            <Border Background="Transparent" Cursor="Hand" Padding="0,3" Tag="{Binding Key}" MouseLeftButtonUp="Child_Click">
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                    <Run Text="{Binding Title, Mode=OneWay}" />
                    <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                </TextBlock>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ChatRow">
            <StackPanel Margin="0,0,0,10">
                <TextBlock>
                    <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </TextBlock>
                <TextBox Text="{Binding Body, Mode=OneWay}" Style="{StaticResource PlainText}" Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,18,24,16">
        <!-- 標題、分頁、搜尋 -->
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <TextBlock Text="我的任務" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="⟳" Style="{StaticResource IconButton}" FontSize="14" ToolTip="重新整理" Click="Reload_Click" Margin="0,0,6,0" />
                    <Button Content="＋ 新增任務" Style="{StaticResource PrimaryButton}" Padding="12,5" Click="New_Click" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,14,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SegmentTrack}">
                    <StackPanel x:Name="TabPanel" Orientation="Horizontal" />
                </Border>
                <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource HintBox}" Margin="12,0,0,0" MaxWidth="320"
                         HorizontalAlignment="Stretch" Tag="🔍 搜尋任務編號或名稱，按 Enter（也找備註、留言）"
                         KeyDown="SearchBox_KeyDown" />
            </Grid>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="6*" />
            </Grid.ColumnDefinitions>

            <!-- 清單 -->
            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                <!-- 狀態篩選與排序 -->
                <Grid DockPanel.Dock="Top" Margin="10,8,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel x:Name="StatusFilterPanel" VerticalAlignment="Center" />
                    <ComboBox x:Name="SortBox" Grid.Column="1" Width="150" VerticalAlignment="Top" Margin="8,0,0,4"
                              SelectionChanged="SortBox_SelectionChanged" ToolTip="排序方式" />
                </Grid>
                <Grid>
                    <ListBox x:Name="TaskList" ItemTemplate="{StaticResource TaskRow}" BorderThickness="0" Background="Transparent"
                             SelectionChanged="TaskList_SelectionChanged" Padding="4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" />
                    <TextBlock x:Name="ListMessage" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="20" />
                </Grid>
                </DockPanel>
            </Border>

            <!-- 詳細 -->
            <Border Grid.Column="2" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <TextBlock x:Name="DetailEmpty" Text="從左邊選一個任務" Foreground="{DynamicResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <ScrollViewer x:Name="DetailPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20,16,16,16">
                        <StackPanel>
                            <TextBlock x:Name="PathText" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="KeyText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,2" />
                            <TextBox x:Name="TitleBox" FontSize="18" FontWeight="SemiBold" Style="{StaticResource InlineEdit}" KeyDown="TitleBox_KeyDown" LostKeyboardFocus="TitleBox_LostFocus"
                                     ToolTip="點一下修改名稱，Enter 儲存" />
                            <TextBlock x:Name="ApprovalText" FontSize="12" Foreground="{DynamicResource WarnBrush}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" Visibility="Collapsed" />

                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="TimerButton" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="0,0,6,6"
                                        Click="Timer_Click" />
                                <Button x:Name="CompleteButton" Content="✓ 停止並完成" Style="{StaticResource FlatButton}" Padding="12,5"
                                        Margin="0,0,6,6" Click="Complete_Click" ToolTip="停止計時並把狀態改成完成" />
                                <Button Content="⏰ 新增提醒" Style="{StaticResource FlatButton}" Padding="12,5" Margin="0,0,6,6"
                                        Click="Remind_Click" />
                                <Button Content="＋ 子任務" Style="{StaticResource FlatButton}" Padding="12,5" Margin="0,0,6,6"
                                        Click="NewChild_Click" />
                                <Button Content="在網頁開啟 ↗" Style="{StaticResource FlatButton}" Padding="12,5" Margin="0,0,6,6"
                                        Click="OpenWeb_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="DetailStatus" TextWrapping="Wrap" Margin="0,2,0,6" Visibility="Collapsed" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="狀態" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="StatusBox" SelectionChanged="StatusBox_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="優先級" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="PriorityBox" SelectionChanged="PriorityBox_SelectionChanged">
                                        <ComboBoxItem Content="緊急" />
                                        <ComboBoxItem Content="高" />
                                        <ComboBoxItem Content="中" />
                                        <ComboBoxItem Content="低" />
                                        <ComboBoxItem Content="無" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock Text="預計開始" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PlannedStartBox" Style="{StaticResource HintBox}" Tag="例 11/5、明天、+3"
                                             LostKeyboardFocus="DateBox_LostFocus" KeyDown="CommitOnEnter" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="預計結束" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="PlannedEndBox" Style="{StaticResource HintBox}" Tag="例 11/8、+5"
                                             LostKeyboardFocus="DateBox_LostFocus" KeyDown="CommitOnEnter" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                                    <TextBlock Text="預估工時（小時）" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="EstimateBox" Style="{StaticResource HintBox}" Tag="例 4、1.5"
                                             LostKeyboardFocus="EstimateBox_LostFocus" KeyDown="CommitOnEnter" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="已記錄工時" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="LoggedText" FontSize="14" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                                    <TextBlock Text="實際日期" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="ActualText" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                                    <TextBlock Text="執行者" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="AssigneesText" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="ChildrenSection">
                                <TextBlock Text="子任務" Style="{StaticResource GroupLabel}" Margin="0,6,0,4" />
                                <ItemsControl x:Name="ChildrenList" ItemTemplate="{StaticResource ChildRow}" />
                            </StackPanel>

                            <StackPanel x:Name="NoteSection">
                                <TextBlock Text="備註" Style="{StaticResource GroupLabel}" Margin="0,10,0,4" />
                                <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="10,8">
                                    <TextBox x:Name="NoteText" Style="{StaticResource PlainText}" MaxHeight="220" VerticalScrollBarVisibility="Auto" />
                                </Border>
                            </StackPanel>

                            <TextBlock Text="聊天" Style="{StaticResource GroupLabel}" Margin="0,14,0,6" />
                            <ItemsControl x:Name="ChatList" ItemTemplate="{StaticResource ChatRow}" />
                            <TextBlock x:Name="ChatEmpty" Text="還沒有訊息" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ChatBox" Style="{StaticResource HintBox}" Tag="傳訊息到這個任務（可用 @帳號），Enter 送出"
                                         KeyDown="ChatBox_KeyDown" AcceptsReturn="False" />
                                <Button x:Name="SendButton" Grid.Column="1" Content="送出" Style="{StaticResource PrimaryButton}"
                                        Margin="8,0,0,0" Padding="14,5" Click="Send_Click" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 新增任務 -->
                    <ScrollViewer x:Name="CreatePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="20,16,16,16">
                        <StackPanel>
                            <TextBlock x:Name="CreateTitle" Text="新增任務" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                            <TextBlock Text="專案" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="NewProject" DisplayMemberPath="Name" Margin="0,0,0,12" />
                            <TextBlock Text="上層任務（選填）" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NewParent" Style="{StaticResource HintBox}" Tag="例 F2P-5；留空就是最上層" Margin="0,0,0,12" />
                            <TextBlock Text="名稱" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="NewTitle" Style="{StaticResource HintBox}" Tag="要做什麼" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="預計開始" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="NewStart" Style="{StaticResource HintBox}" Tag="今天" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="預計結束" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="NewEnd" Style="{StaticResource HintBox}" Tag="例 +3" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="預估工時" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="NewEstimate" Style="{StaticResource HintBox}" Tag="小時" />
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="NewAssignMe" Content="指派給我" IsChecked="True" Margin="0,0,0,8" />
                            <CheckBox x:Name="NewStartTimer" Content="建立後馬上開始計時" Margin="0,0,0,16" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CreateButton" Content="建立" Style="{StaticResource PrimaryButton}" Padding="18,6" Click="Create_Click" />
                                <Button Content="取消" Style="{StaticResource FlatButton}" Padding="18,6" Margin="8,0,0,0" Click="CancelCreate_Click" />
                            </StackPanel>
                            <TextBlock x:Name="CreateStatus" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                            <TextBlock Style="{StaticResource CardDesc}" Margin="0,14,0,0"
                                       Text="執行者建立的任務要等管理者核准，但可以馬上計時。" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
