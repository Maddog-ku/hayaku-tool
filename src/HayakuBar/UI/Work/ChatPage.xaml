<UserControl x:Class="HayakuBar.UI.Work.ChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,18,24,16">
        <TextBlock DockPanel.Dock="Top" Text="聊天" Style="{StaticResource PageTitle}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 對話清單 -->
            <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                        <TextBlock Text="任務聊天" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TaskInput" Style="{StaticResource HintBox}" Tag="輸入任務編號，按 Enter" KeyDown="TaskInput_KeyDown" />
                        <TextBlock Text="專案頻道" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                    </StackPanel>
                    <Grid>
                        <ListBox x:Name="ChannelList" BorderThickness="0" Background="Transparent" Padding="4,0,4,6"
                                 SelectionChanged="ChannelList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ChannelEmpty" Text="讀取中…" Foreground="{DynamicResource MutedBrush}" Margin="14,4" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 訊息 -->
            <Border Grid.Column="2" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,12,12,8">
                        <StackPanel>
                            <TextBlock x:Name="ConversationTitle" Text="選一個對話" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="ConversationSubtitle" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="ReloadButton" Content="⟳" Style="{StaticResource IconButton}" FontSize="14" ToolTip="重新整理"
                                    Click="Reload_Click" IsEnabled="False" />
                            <Button x:Name="WebButton" Content="在網頁開啟 ↗" Style="{StaticResource IconButton}" Click="Web_Click" Margin="6,0,0,0"
                                    IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MessageInput" Style="{StaticResource HintBox}" Tag="輸入訊息（可用 @帳號 提及），Enter 送出、Shift+Enter 換行"
                                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                         PreviewKeyDown="MessageInput_PreviewKeyDown" IsEnabled="False" />
                                <Button x:Name="SendButton" Grid.Column="1" Content="送出" Style="{StaticResource PrimaryButton}" Padding="16,6"
                                        Margin="8,0,0,0" VerticalAlignment="Bottom" Click="Send_Click" IsEnabled="False" />
                            </Grid>
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Grid>
                        <ScrollViewer x:Name="MessageScroll" VerticalScrollBarVisibility="Auto" Padding="16,4,12,4">
                            <ItemsControl x:Name="MessageList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock>
                                                <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Time, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                            </TextBlock>
                                            <TextBox Text="{Binding Body, Mode=OneWay}" Style="{StaticResource PlainText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="MessageEmpty" Text="從左邊選頻道，或輸入任務編號打開任務的聊天"
                                   Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
