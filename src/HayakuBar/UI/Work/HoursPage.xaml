<UserControl x:Class="HayakuBar.UI.Work.HoursPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Stat" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <DataTemplate x:Key="DayCell">
            <Border Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="{Binding BorderThickness}"
                    CornerRadius="7" Margin="3" Padding="8,6" Cursor="{Binding Cursor}" Tag="{Binding}"
                    MouseLeftButtonUp="Day_Click" ToolTip="{Binding Tip}" Opacity="{Binding Opacity}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{Binding DayText}" FontWeight="{Binding DayWeight}" />
                        <TextBlock Text="{Binding Tag}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding Value}" Foreground="{Binding ValueBrush}" FontSize="12"
                               FontFamily="{StaticResource MonoFont}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,18,24,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="我的工時" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="‹" Style="{StaticResource FlatButton}" FontSize="15" Padding="10,2" Click="Prev_Click" ToolTip="上個月" />
                <TextBlock x:Name="MonthText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" MinWidth="96"
                           TextAlignment="Center" />
                <Button Content="›" Style="{StaticResource FlatButton}" FontSize="15" Padding="10,2" Click="Next_Click" ToolTip="下個月" />
                <Button x:Name="ThisMonthButton" Content="本月" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="ThisMonth_Click" />
            </StackPanel>
        </Grid>

        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,-8,12">
            <Border Style="{StaticResource Stat}">
                <StackPanel>
                    <TextBlock Text="已填" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="FilledText" Style="{StaticResource StatValue}" />
                    <TextBlock Text="同時計時只算一次" Style="{StaticResource CardDesc}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
                <StackPanel>
                    <TextBlock Text="應出勤" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="ExpectedText" Style="{StaticResource StatValue}" />
                    <TextBlock x:Name="ExpectedToDateText" Style="{StaticResource CardDesc}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
                <StackPanel>
                    <TextBlock Text="還差" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="MissingText" Style="{StaticResource StatValue}" />
                    <TextBlock Text="到今天為止" Style="{StaticResource CardDesc}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Stat}">
                <StackPanel>
                    <TextBlock Text="沒填滿的日子" Style="{StaticResource FieldLabel}" />
                    <TextBlock x:Name="UnfilledText" Style="{StaticResource StatValue}" />
                    <TextBlock x:Name="UnfilledDetail" Style="{StaticResource CardDesc}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4,8,0,0">
            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource FilledBrush}" Margin="0,0,5,0" />
            <TextBlock Text="填滿" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0" />
            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource PartialBrush}" Margin="0,0,5,0" />
            <TextBlock Text="不足" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0" />
            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource MissingBrush}" Margin="0,0,5,0" />
            <TextBlock Text="沒填" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0" />
            <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource OffDayBrush}" Margin="0,0,5,0" />
            <TextBlock Text="不用上班或請假" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,14,0" />
            <TextBlock Text="點日期可以查看、補登那天的工時" FontSize="11" Foreground="{DynamicResource HintBrush}" Margin="10,0,0,0" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <UniformGrid Columns="7" Margin="0,0,0,4">
                <TextBlock Text="一" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                <TextBlock Text="二" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                <TextBlock Text="三" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                <TextBlock Text="四" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                <TextBlock Text="五" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                <TextBlock Text="六" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
                <TextBlock Text="日" Style="{StaticResource FieldLabel}" Margin="8,0,0,0" />
            </UniformGrid>
            <ItemsControl x:Name="DayGrid" Grid.Row="1" ItemTemplate="{StaticResource DayCell}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock x:Name="LoadingText" Grid.Row="1" Text="讀取中…" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
