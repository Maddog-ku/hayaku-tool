<UserControl x:Class="HayakuBar.UI.Work.MeetingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,18,24,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="會議" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" />
            <Button x:Name="NewButton" Content="＋ 新增會議" Style="{StaticResource PrimaryButton}" Padding="12,5" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Click="New_Click" />
        </Grid>

        <!-- 新增 -->
        <Border x:Name="FormCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="新增會議" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="專案" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ProjectBox" DisplayMemberPath="Name" SelectionChanged="ProjectBox_SelectionChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="標題" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TitleInput" Style="{StaticResource HintBox}" Tag="例 週會、需求討論" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="日期" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="DateInput" Style="{StaticResource HintBox}" Tag="今天、明天、11/5" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="開始" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="StartInput" Style="{StaticResource HintBox}" Tag="14:00" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="結束" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="EndInput" Style="{StaticResource HintBox}" Tag="15:00" FontFamily="{StaticResource MonoFont}" />
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="地點或連結（選填）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LocationInput" Style="{StaticResource HintBox}" Tag="會議室、Teams 連結…" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="參加者" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                <ItemsControl x:Name="AttendeeList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="0,0,14,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="議程（選填）" Style="{StaticResource FieldLabel}" Margin="0,6,0,4" />
                <TextBox x:Name="NoteInput" Style="{StaticResource HintBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54"
                         VerticalContentAlignment="Top" Tag="" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="CreateButton" Content="建立" Style="{StaticResource PrimaryButton}" Padding="18,6" Click="Create_Click" />
                    <Button Content="取消" Style="{StaticResource FlatButton}" Padding="18,6" Margin="8,0,0,0" Click="Cancel_Click" />
                </StackPanel>
                <TextBlock x:Name="FormStatus" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentTrack}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="MeetTab" Tag="upcoming" Content="接下來" IsChecked="True"
                             Checked="Tab_Checked" />
                <RadioButton Style="{StaticResource Segment}" GroupName="MeetTab" Tag="past" Content="參加過的" Checked="Tab_Checked" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="ListStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MeetingList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Day}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" Foreground="{Binding TimeBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDesc}" TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="加入並計時" Style="{StaticResource PrimaryButton}" Padding="10,4" Tag="{Binding}"
                                                Click="Join_Click" Visibility="{Binding JoinVisibility}" Margin="6,0,0,0" />
                                        <Button Content="離開" Style="{StaticResource FlatButton}" Padding="10,4" Tag="{Binding}"
                                                Click="Leave_Click" Visibility="{Binding LeaveVisibility}" Margin="6,0,0,0"
                                                ToolTip="停止這場會議的計時" />
                                        <Button Content="開啟" Style="{StaticResource IconButton}" Tag="{Binding}" Click="Open_Click" Margin="6,0,0,0" />
                                        <Button Content="取消會議" Style="{StaticResource IconButton}" Tag="{Binding}" Click="CancelMeeting_Click"
                                                Visibility="{Binding CancelVisibility}" Margin="6,0,0,0"
                                                ToolTip="主辦、專案管理員才能取消；會通知參加者" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
