<UserControl x:Class="HayakuBar.UI.Work.LeavesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:HayakuBar.UI">
    <DockPanel Margin="24,18,24,16">
        <TextBlock DockPanel.Dock="Top" Text="請假" Style="{StaticResource PageTitle}" />

        <!-- 登記 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="登記請假" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="只登記、不簽核；登記後當天不用上班，自動上下班也會跳過" Style="{StaticResource CardDesc}"
                               HorizontalAlignment="Right" Margin="0" />
                </Grid>
                <Border Style="{StaticResource SegmentTrack}" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SpanDay" Style="{StaticResource Segment}" GroupName="Span" Tag="DAY" Content="整天" IsChecked="True"
                                     Checked="Span_Checked" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Span" Tag="HALF_AM" Content="上午" Checked="Span_Checked" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Span" Tag="HALF_PM" Content="下午" Checked="Span_Checked" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="Span" Tag="RANGE" Content="指定時段" Checked="Span_Checked" />
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DateLabel" Text="第一天 ～ 最後一天（只請一天就點同一天）" Style="{StaticResource FieldLabel}" />
                        <ui:DateRangePicker x:Name="Dates" />
                    </StackPanel>
                    <Grid x:Name="RangePanel" Grid.Column="2" Width="160" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="開始" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="StartInput" Style="{StaticResource HintBox}" Tag="14:00" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="結束" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="EndInput" Style="{StaticResource HintBox}" Tag="16:00" FontFamily="{StaticResource MonoFont}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="備註（只有自己與管理者看得到）" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NoteInput" Style="{StaticResource HintBox}" Tag="選填" />
                    </StackPanel>
                    <Button x:Name="AddButton" Grid.Column="6" Content="登記" Style="{StaticResource PrimaryButton}" Padding="18,6"
                            VerticalAlignment="Bottom" Click="Add_Click" />
                </Grid>
                <TextBlock x:Name="FormStatus" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Border Style="{StaticResource SegmentTrack}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="LeaveRange" Tag="2w" Content="接下來兩週" IsChecked="True"
                                 Checked="Range_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="LeaveRange" Tag="month" Content="本月" Checked="Range_Checked" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="LeaveRange" Tag="next" Content="下個月" Checked="Range_Checked" />
                </StackPanel>
            </Border>
            <CheckBox x:Name="MineOnly" Content="只看我的" HorizontalAlignment="Right" VerticalAlignment="Center" Click="MineOnly_Click" />
        </Grid>
        <TextBlock x:Name="ListStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LeaveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="30" Height="30" Margin="0,0,12,0">
                                        <Ellipse Fill="{DynamicResource AvatarBrush}" />
                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Period}" Style="{StaticResource CardDesc}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Lost}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                               Margin="12,0" />
                                    <Button Grid.Column="3" Content="取消請假" Style="{StaticResource IconButton}" Tag="{Binding}" Click="Cancel_Click"
                                            Visibility="{Binding CancelVisibility}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                       Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
