<UserControl x:Class="HayakuBar.UI.Work.TeamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
                    <DataTemplate x:Key="PersonCard">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="14,12" VerticalAlignment="Top">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="34" Height="34" Margin="0,0,10,0">
                                        <Ellipse Fill="{DynamicResource AvatarBrush}" />
                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Ellipse Width="10" Height="10" Fill="{Binding DotBrush}" Stroke="{DynamicResource BgBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Job}" Style="{StaticResource CardDesc}" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Pill}" Visibility="{Binding StateVisibility}">
                                        <TextBlock Text="{Binding State}" FontSize="11" Foreground="{Binding StateBrush}" />
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Timing}" Margin="44,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent" Cursor="{Binding Cursor}" Tag="{Binding}"
                                                    MouseLeftButtonUp="Timing_Click" Padding="0,2">
                                                <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Tip}">
                                                    <Run Text="●" Foreground="{DynamicResource RunBrush}" FontSize="9" />
                                                    <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                                    <Run Text="{Binding Since, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="24,18,24,16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="團隊狀況" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" />
            <Button Content="⟳ 重新整理" Style="{StaticResource FlatButton}" Padding="12,5" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Reload_Click" />
        </Grid>
        <TextBlock x:Name="CountsText" DockPanel.Dock="Top" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14" />
        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="LeftList" ItemTemplate="{StaticResource PersonCard}" VerticalAlignment="Top" />
                <ItemsControl x:Name="RightList" Grid.Column="1" ItemTemplate="{StaticResource PersonCard}" VerticalAlignment="Top" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
