<UserControl x:Class="HayakuBar.UI.Work.EipLeavesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="24,18,24,16">
        <TextBlock DockPanel.Dock="Top" Text="EIP 請假紀錄" Style="{StaticResource PageTitle}" />

        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevButton" Content="‹ 上個月" Style="{StaticResource FlatButton}" Click="Prev_Click" />
                <TextBlock x:Name="MonthText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0" MinWidth="110"
                           TextAlignment="Center" />
                <Button x:Name="NextButton" Content="下個月 ›" Style="{StaticResource FlatButton}" Click="Next_Click" />
                <Button x:Name="ThisMonthButton" Content="本月" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="ThisMonth_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <Button x:Name="ReloadButton" Content="⟳ 重新讀取" Style="{StaticResource FlatButton}" Click="Reload_Click"
                        ToolTip="重新從 EIP 讀這一年的假單（平常切換月份用讀過的資料）" />
            </StackPanel>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardDesc}" Margin="2,0,0,10"
                   Text="直接讀公司 EIP「假單」頁（待審、核准、駁回），列出跟這個月有重疊的；標「已登記到 Hayaku」的是由下班時同步登記的。" />
        <TextBlock x:Name="ListStatus" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"
                   Foreground="{DynamicResource ErrorBrush}" />

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LeaveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Period}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDesc}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Detail}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Pill}" Visibility="{Binding SyncedVisibility}" Margin="0,0,6,0">
                                            <TextBlock Text="已登記到 Hayaku" FontSize="11" Foreground="{DynamicResource RunBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Pill}">
                                            <TextBlock Text="{Binding State}" FontSize="11" Foreground="{Binding StateBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                       TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</UserControl>
