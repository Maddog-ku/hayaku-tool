                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="Slack App" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="SlackAccountText" Style="{StaticResource CardDesc}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Pill}" Padding="10,4">
