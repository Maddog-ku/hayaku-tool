                                <ComboBoxItem Content="矮（360）" Tag="360" />
                                <ComboBoxItem Content="中（440）" Tag="440" />
                                <ComboBoxItem Content="高（520）" Tag="520" />
                                <ComboBoxItem Content="更高（600）" Tag="600" />
                                <ComboBoxItem Content="跟著內容" Tag="0" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="開關面板的快捷鍵" Style="{StaticResource CardTitle}" />
