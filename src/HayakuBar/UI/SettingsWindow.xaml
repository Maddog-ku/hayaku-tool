                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="紀錄與設定檔" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="DataDirText" Style="{StaticResource CardDesc}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="開啟資料夾" Style="{StaticResource FlatButton}"
                                    Click="OpenDataDir_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
