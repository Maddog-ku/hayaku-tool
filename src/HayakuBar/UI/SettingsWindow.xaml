                                <ComboBoxItem Content="停留 5 秒" Tag="5" />
                                <ComboBoxItem Content="停留 8 秒" Tag="8" />
                                <ComboBoxItem Content="停留 15 秒" Tag="15" />
                                <ComboBoxItem Content="不自動收回" Tag="0" />
                            </ComboBox>
                            <CheckBox x:Name="NotificationAlertsBox" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click" />
                        </Grid>
