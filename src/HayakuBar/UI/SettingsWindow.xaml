<Window x:Class="HayakuBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HayakuBar 設定" Width="620" Height="640" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13" Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="儲存" IsDefault="True" Style="{StaticResource PrimaryButton}" Padding="18,5" Click="Save_Click" />
            <Button Content="取消" IsCancel="True" Style="{StaticResource FlatButton}" Padding="18,5" Margin="8,0,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="帳號" FontWeight="SemiBold" FontSize="14" />
                <Grid Margin="0,6,0,0">
                    <TextBlock x:Name="AccountText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                    <Button x:Name="AccountButton" HorizontalAlignment="Right" Style="{StaticResource FlatButton}"
                            Click="Account_Click" />
                </Grid>

                <TextBlock Text="上下班" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,0" />
                <CheckBox x:Name="AutoScheduleBox" Margin="0,6,0,0"
                          Content="依 Hayaku 班表自動上下班（上班開始計時、休息暫停、休息後恢復、下班停止）" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="22,2,0,0"
                           Text="班表、請假、國定假日都以 Hayaku 為準。工時條上的「上班／下班」按鈕可隨時手動覆寫；按了下班當天就不再自動上班。" />

                <TextBlock Text="Claude Code" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,0" />
                <CheckBox x:Name="ClaudeEnabledBox" Margin="0,6,0,0" Content="Claude 在下面的 repo 有動作時，自動為對應任務開始計時（之後持續計時，不會因閒置暫停）" />
                <CheckBox x:Name="ClaudeOnlyWorkBox" Margin="0,4,0,0" Content="只在上班時間（或我有手動計時）時才自動計時" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"
                           Text="任務判斷順序：手動指定 → 對話裡提到的任務編號 → git 分支名稱（例 feature/F2P-97-xxx）→ repo 預設任務。" />

                <ListView x:Name="RepoList" Height="150" Margin="0,8,0,0" SelectionChanged="RepoList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Repo 路徑" Width="300" DisplayMemberBinding="{Binding Path}" />
                            <GridViewColumn Header="預設任務" Width="90" DisplayMemberBinding="{Binding DefaultTask}" />
                            <GridViewColumn Header="Hooks" Width="80" DisplayMemberBinding="{Binding HooksText}" />
                            <GridViewColumn Header="啟用" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="新增 repo…" Style="{StaticResource FlatButton}" Click="AddRepo_Click" />
                    <Button Content="移除" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="RemoveRepo_Click" />
                    <TextBlock Text="預設任務" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox x:Name="DefaultTaskBox" Width="90" Padding="3,1" LostFocus="DefaultTaskBox_LostFocus" />
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0">
                    <Button Content="安裝 Claude hooks" Style="{StaticResource FlatButton}" Click="InstallHooks_Click" />
                    <Button Content="移除 hooks" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="UninstallHooks_Click" />
                </WrapPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0">
                    不裝 hooks 也能用：工具會讀 ~/.claude/projects 裡的 session 紀錄。裝了 hooks（寫進 repo 的
                    .claude/settings.local.json）偵測會更即時，送出指令就馬上開始計時。
                </TextBlock>

                <TextBlock Text="工作列" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="顯示在" VerticalAlignment="Center" />
                    <ComboBox x:Name="AnchorBox" Width="150" Margin="8,0" SelectedValuePath="Tag">
                        <ComboBoxItem Content="最左邊" Tag="Left" />
                        <ComboBoxItem Content="工作列圖示左側" Tag="BeforeStart" />
                        <ComboBoxItem Content="工作列圖示右側" Tag="AfterIcons" />
                        <ComboBoxItem Content="通知區域左側" Tag="BeforeTray" />
                    </ComboBox>
                    <TextBlock Text="微調" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBox x:Name="OffsetBox" Width="52" Margin="6,0" Padding="3,1" HorizontalContentAlignment="Center" />
                    <TextBlock Text="px（正數往右）" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="顯示方式" VerticalAlignment="Center" />
                    <RadioButton x:Name="OneLineRadio" Content="一排（較寬）" GroupName="Layout" Margin="10,0,0,0"
                                 VerticalAlignment="Center" />
                    <RadioButton x:Name="TwoLineRadio" Content="兩排（較窄）" GroupName="Layout" Margin="14,0,0,0"
                                 VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"
                           Text="也可以直接在工作列上左右拖曳工時來微調；在工時上按右鍵有同樣的選單。開了很多 app 放不下時，會自動移到不會蓋到圖示的位置。" />

                <TextBlock Text="其他" FontWeight="SemiBold" FontSize="14" Margin="0,18,0,0" />
                <CheckBox x:Name="StartupBox" Margin="0,6,0,0" Content="開機時自動啟動 HayakuBar" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="每" VerticalAlignment="Center" />
                    <TextBox x:Name="PollBox" Width="44" Margin="6,0" Padding="3,1" HorizontalContentAlignment="Center" />
                    <TextBlock Text="秒跟 Hayaku 同步一次" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
