                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="面板高度" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="固定高度時切換分頁不會跳動，內容放不下會捲動；「跟著內容」會依分頁內容伸縮。" />
                            </StackPanel>
                            <ComboBox x:Name="PanelHeightBox" Grid.Column="1" Width="150" SelectedValuePath="Tag"
