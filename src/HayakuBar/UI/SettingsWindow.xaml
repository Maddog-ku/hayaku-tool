                            </StackPanel>
                            <CheckBox x:Name="QuietWhenBusyBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="下班時工時沒滿提示補登" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="按下班時今天還沒滿應出勤，提示框會多一個「補登工時」。" />
                            </StackPanel>
                            <CheckBox x:Name="PromptUnfilledBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Click="Toggle_Click" />
                        </Grid>
                    </Border>
                    <TextBlock Text="其他" Style="{StaticResource GroupLabel}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="開機時自動啟動" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="登入 Windows 後自動開啟 HayakuBar。" />
