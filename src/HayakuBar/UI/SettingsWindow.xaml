<Window x:Class="HayakuBar.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HayakuBar 設定" Width="800" Height="600" MinWidth="680" MinHeight="480"
        Icon="/Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource SubtleBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="ProjectRow">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip="{Binding Path}" />
                    <TextBlock Text="{Binding Detail}" Foreground="{Binding DetailBrush}" FontSize="12" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                </StackPanel>
                <CheckBox Grid.Column="2" Content="自動建立任務" IsChecked="{Binding AutoCreate}" FontSize="12"
                          VerticalAlignment="Center" Margin="0,0,14,0" IsEnabled="{Binding Enabled}"
                          ToolTip="Claude 在這個專案改了程式、又對應不到任務時，跳提示問要不要建立任務（只是問問題不會跳）" />
                <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"
                          ToolTip="這個專案要不要自動計時" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="RepoCard">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Data="M1,3 C1,2 1.6,1.5 2.5,1.5 L7,1.5 L9,3.5 L17.5,3.5 C18.4,3.5 19,4.1 19,5 L19,14 C19,14.9 18.4,15.5 17.5,15.5 L2.5,15.5 C1.6,15.5 1,14.9 1,14 Z"
                              Fill="{DynamicResource FolderBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" Width="20" Height="17"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" Style="{StaticResource SettingText}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Path}" ToolTip="{Binding Path}" Style="{StaticResource CardDesc}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"
                                  ToolTip="啟用／停用整個主資料夾的自動計時" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <CheckBox Content="自動建立任務" IsChecked="{Binding AutoCreate}" FontSize="12" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" IsEnabled="{Binding Enabled}"
                                  ToolTip="在這個資料夾本身（不含裡面的專案）開的 Claude session 改了程式、又對應不到任務時，跳提示問要不要建立任務" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding HooksText}" Foreground="{Binding HooksBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="{Binding HooksAction}" Tag="{Binding}" Click="Hooks_Click"
                                    Style="{StaticResource FlatButton}" />
                            <Button Content="移除" Tag="{Binding}" Click="RemoveRepo_Click"
                                    Style="{StaticResource FlatButton}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{DynamicResource SubtleBrush}" CornerRadius="6" Padding="10,7" Margin="0,10,0,0"
                            Visibility="{Binding RootActivityVisibility}">
                        <TextBlock Text="{Binding ActivityText}" Foreground="{Binding ActivityBrush}" FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- 裡面的專案 -->
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding ProjectsHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="自動偵測" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IncludeSubprojects}"
                                              ToolTip="自動找出裡面的專案（git repo，或 Claude 開過 session 的子資料夾）" />
                                    <Button Content="重新偵測" Tag="{Binding}" Click="Redetect_Click"
                                            Style="{StaticResource IconButton}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource CardDesc}" Margin="0,4,0,4" Visibility="{Binding ProjectsVisibility}"
                                       Text="每個專案各自計時，可個別停用；勾「自動建立任務」的專案，Claude 改了程式卻對應不到任務時會問你要不要建立。" />
                            <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ProjectRow}"
                                          Visibility="{Binding ProjectsVisibility}" />
                            <TextBlock Style="{StaticResource CardDesc}" Margin="0,6,0,0" Visibility="{Binding ProjectsEmptyVisibility}"
                                       Text="沒有偵測到專案。子資料夾要是 git repo，或 Claude 曾在裡面開過 session。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 導覽 -->
        <DockPanel Margin="14,18,10,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,18">
                <Image Source="/Assets/app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="HayakuBar" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock x:Name="NavUserText" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" FontSize="11" Margin="8,0,0,0"
                       Foreground="{DynamicResource MutedBrush}" />
            <StackPanel x:Name="NavPanel">
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="PageAccount" Checked="Nav_Checked"
                             x:Name="NavAccount" Content="帳號" />
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="PageTaskbar" Checked="Nav_Checked"
                             Content="工作列" />
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="PageSchedule" Checked="Nav_Checked"
                             Content="上下班" />
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="PageRepos" Checked="Nav_Checked"
                             Content="專案" />
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="PageClaude" Checked="Nav_Checked"
                             Content="Claude Code" />
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="PageEip" Checked="Nav_Checked"
                             Content="EIP 請假" />
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="PageSlack" Checked="Nav_Checked"
                             Content="Slack" />
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="PageGeneral" Checked="Nav_Checked"
                             Content="一般" />
            </StackPanel>
        </DockPanel>

        <!-- 內容 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20,28,20">
            <Grid MaxWidth="720" HorizontalAlignment="Stretch">

                <!-- 帳號 -->
                <StackPanel x:Name="PageAccount">
                    <TextBlock Text="帳號" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44" Margin="0,0,14,0">
                                <Ellipse Fill="{DynamicResource AvatarBrush}" />
                                <TextBlock x:Name="AvatarText" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="17" FontWeight="SemiBold" />
                            </Grid>
                            <StackPanel Grid.Column="1" Style="{StaticResource SettingText}">
                                <TextBlock x:Name="AccountName" Style="{StaticResource CardTitle}" FontWeight="SemiBold" />
                                <TextBlock x:Name="AccountDetail" Style="{StaticResource CardDesc}" />
                            </StackPanel>
                            <Button x:Name="AccountButton" Grid.Column="2" Style="{StaticResource FlatButton}"
                                    Padding="16,6" Click="Account_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="連線方式" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="以 Hayaku「已連線的應用程式」授權，工具不會碰到密碼；可隨時在 Hayaku「我的 › 已連線的應用程式」撤銷。" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="開啟 Hayaku" Style="{StaticResource FlatButton}"
                                    Click="OpenWeb_Click" />
                        </Grid>
                    </Border>
                    <!-- Hayaku 的 MCP 沒有提供的個人設定：直接開網頁的那一頁 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Hayaku 個人設定" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource CardDesc}" Margin="0,2,0,8"
                                       Text="這些設定 Hayaku 還沒開放給應用程式改，點了直接開網頁的那一頁。" />
                            <WrapPanel>
                                <Button Content="基本資料與偏好" Style="{StaticResource LinkButton}" Margin="0,0,16,4" Tag="/me" Click="WebSetting_Click"
                                        ToolTip="頭像、顯示名稱、職稱、工時顯示單位、同一時間只能有一個進行中任務" />
                                <Button Content="外觀" Style="{StaticResource LinkButton}" Margin="0,0,16,4" Tag="/me?tab=appearance" Click="WebSetting_Click"
                                        ToolTip="網頁的淺色、暗色、跟隨系統" />
                                <Button Content="工作時間" Style="{StaticResource LinkButton}" Margin="0,0,16,4" Tag="/me?tab=work-time" Click="WebSetting_Click"
                                        ToolTip="依工作時間自動暫停計時（午休、下班）" />
                                <Button Content="通知" Style="{StaticResource LinkButton}" Margin="0,0,16,4" Tag="/me?tab=notifications" Click="WebSetting_Click"
                                        ToolTip="通知量、各類通知要不要推播、提醒的預設方式、Hayaku 的 Slack 開通" />
                                <Button Content="安全" Style="{StaticResource LinkButton}" Margin="0,0,16,4" Tag="/me?tab=security" Click="WebSetting_Click"
                                        ToolTip="兩步驟驗證" />
                                <Button Content="已連線的應用程式" Style="{StaticResource LinkButton}" Margin="0,0,16,4" Tag="/me?tab=claude" Click="WebSetting_Click"
                                        ToolTip="Claude Code、HayakuBar 等已授權的應用程式，可以中斷連線" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 工作列 -->
                <StackPanel x:Name="PageTaskbar" Visibility="Collapsed">
                    <TextBlock Text="工作列" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="顯示位置" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="放不下時會自動移到不會蓋到圖示的地方。" />
                            </StackPanel>
                            <ComboBox x:Name="AnchorBox" Grid.Column="1" Width="170" SelectedValuePath="Tag"
                                      VerticalAlignment="Center" SelectionChanged="Anchor_Changed">
                                <ComboBoxItem Content="最左邊" Tag="Left" />
                                <ComboBoxItem Content="工作列圖示左側" Tag="BeforeStart" />
                                <ComboBoxItem Content="工作列圖示右側" Tag="AfterIcons" />
                                <ComboBoxItem Content="通知區域左側" Tag="BeforeTray" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="顯示方式" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="一排比較寬、好讀；兩排比較窄，適合空間不多時。" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource SegmentTrackBrush}" CornerRadius="7" Padding="3" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="OneLineRadio" Style="{StaticResource Segment}" GroupName="Layout"
                                                 Content="一排" Checked="Layout_Checked" />
                                    <RadioButton x:Name="TwoLineRadio" Style="{StaticResource Segment}" GroupName="Layout"
                                                 Content="兩排" Checked="Layout_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="位置微調" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}" Text="正數往右、負數往左。也可以直接在工作列上左右拖曳工時。" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="OffsetBox" Width="64" HorizontalContentAlignment="Center"
                                         KeyDown="CommitOnEnter" LostFocus="Offset_LostFocus" />
                                <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,10,0"
                                           Foreground="{DynamicResource MutedBrush}" />
                                <Button Content="重設" Style="{StaticResource FlatButton}" Click="ResetOffset_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InfoCard}">
                        <TextBlock Style="{StaticResource CardDesc}" Margin="0"
                                   Text="在工作列的工時上按右鍵，也可以切換位置和顯示方式。" />
                    </Border>
                </StackPanel>

                <!-- 上下班 -->
                <StackPanel x:Name="PageSchedule" Visibility="Collapsed">
                    <TextBlock Text="上下班" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="依班表自動上下班" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="班表、請假、國定假日都以 Hayaku 為準。" />
                            </StackPanel>
                            <CheckBox x:Name="AutoScheduleBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Click="Toggle_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="今天的班表" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="ScheduleText" Style="{StaticResource CardDesc}" FontSize="13" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="自動做的事" Style="{StaticResource GroupLabel}" />
                    <Border Style="{StaticResource InfoCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Margin" Value="0,3" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>
                            <TextBlock Text="上班時間到" FontWeight="SemiBold" Margin="0,3,18,3" />
                            <TextBlock Grid.Column="1" Text="恢復上次那組任務開始計時" />
                            <TextBlock Grid.Row="1" Text="休息開始" FontWeight="SemiBold" Margin="0,3,18,3" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="全部暫停" />
                            <TextBlock Grid.Row="2" Text="休息結束" FontWeight="SemiBold" Margin="0,3,18,3" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="自動恢復休息前在跑的任務" />
                            <TextBlock Grid.Row="3" Text="下班時間到" FontWeight="SemiBold" Margin="0,3,18,3" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="全部停止" />
                            <TextBlock Grid.Row="4" Text="手動" FontWeight="SemiBold" Margin="0,3,18,3" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="面板上的「上班／下班」隨時可按；按了下班當天就不再自動上班。" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Claude Code -->
                <StackPanel x:Name="PageClaude" Visibility="Collapsed">
                    <TextBlock Text="Claude Code" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="自動計時" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="Claude 在「專案」頁的資料夾裡有動作時，為對應任務開始計時，之後持續計時到休息、下班或手動暫停。" />
                            </StackPanel>
                            <CheckBox x:Name="ClaudeEnabledBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Click="Toggle_Click" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Style="{StaticResource SettingText}">
                                <TextBlock Text="只在上班時間自動計時" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="下班後或休息時 Claude 有動作不會開始計時（你有手動計時在跑時除外）。" />
                            </StackPanel>
                            <CheckBox x:Name="ClaudeOnlyWorkBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      Click="Toggle_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Text="怎麼判斷是哪個任務" Style="{StaticResource GroupLabel}" />
                    <Border Style="{StaticResource InfoCard}">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                       Text="依序看：面板上手動指定 → 對話裡提到的任務編號 → git 分支名稱（例 feature/F2P-97-xxx）。都偵測不到就不計時，可在面板的 Claude 區按「選擇」指定這個 session 的任務。" />
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="在「專案」頁勾了「自動建立任務」的專案：Claude 開始改程式、卻對應不到任務時，會跳提示問要不要建立任務（只是問問題、規劃不會跳，同一個 session 只問一次）。建立時專案會自動選好，你選專案樹上的位置、狀態與預計起訖，建好後就為這個 session 計時。" />
                            <TextBlock Style="{StaticResource CardDesc}" Margin="0,8,0,0"
                                       Text="CLI 和桌面版的 session 都存在 %USERPROFILE%\.claude\projects，兩邊都會偵測到。要監看哪些資料夾、停用哪些專案，在「專案」頁設定。" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- EIP 請假 -->
                <StackPanel x:Name="PageEip" Visibility="Collapsed">
                    <TextBlock Text="EIP 請假" Style="{StaticResource PageTitle}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- 已登入：只顯示帳號、已登入、登出 -->
                            <Grid x:Name="EipLoggedInPanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource SettingText}">
                                    <TextBlock Text="EIP 帳號" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="EipAccountText" Style="{StaticResource CardDesc}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Pill}" Padding="10,4">
                                        <TextBlock Text="✓ 已登入" FontSize="12" Foreground="{DynamicResource RunBrush}" />
                                    </Border>
                                    <Button Content="登出" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="EipLogout_Click"
                                            ToolTip="刪掉存在這台電腦的 EIP 帳密，之後不再同步請假" />
                                </StackPanel>
                            </Grid>

                            <!-- 還沒登入：輸入帳密 -->
                            <StackPanel x:Name="EipLoginPanel">
                                <TextBlock Text="EIP 帳號" Style="{StaticResource CardTitle}" />
                                <TextBlock Style="{StaticResource CardDesc}"
                                           Text="用來讀取你在公司 EIP 的請假紀錄。帳密用 Windows 加密存在這台電腦，只有你的 Windows 帳號解得開。" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="帳號" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="EipAccountBox" Height="30" KeyDown="EipBox_KeyDown" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="密碼" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="EipPasswordBox" Height="30" KeyDown="EipBox_KeyDown" />
                                    </StackPanel>
                                </Grid>
                                <Button x:Name="EipTestButton" Content="登入" Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Right" Padding="16,5" Margin="0,12,0,0" Click="EipTest_Click"
                                        ToolTip="實際登入 EIP 一次，成功才會儲存" />
                            </StackPanel>

                            <TextBlock x:Name="EipStatus" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Style="{StaticResource SettingText}">
                                    <TextBlock Text="上班前、下班時同步請假到 Hayaku" Style="{StaticResource CardTitle}" />
                                    <TextBlock Style="{StaticResource CardDesc}"
