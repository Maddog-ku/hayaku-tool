<Window x:Class="HayakuBar.UI.HoverCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HayakuBar 摘要" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight" FontFamily="{StaticResource UiFont}" FontSize="12"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <Border Margin="6" Padding="12,10" CornerRadius="8" MinWidth="220" MaxWidth="360"
            Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.2" />
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="HeaderText" FontWeight="SemiBold" />
            <TextBlock x:Name="SubText" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
            <ItemsControl x:Name="Rows" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}" FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" Margin="0,0,10,0">
                                <Run Text="{Binding Key, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding Title, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" />
                            </TextBlock>
                            <TextBlock Grid.Column="2" Text="{Binding Elapsed}" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="FooterText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0"
                       Text="點一下打開面板 · 右鍵看更多選項" />
        </StackPanel>
    </Border>
</Window>
