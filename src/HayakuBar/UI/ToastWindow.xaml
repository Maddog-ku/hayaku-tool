<Window x:Class="HayakuBar.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HayakuBar 通知" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="360" SizeToContent="Height"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <!-- 外層裁切：從下緣滑上來時，超出視窗的部分不顯示 -->
    <Grid ClipToBounds="True">
    <!-- 陰影放在獨立的空白圖層，滑動時不用每一格重算整張卡片 -->
    <Grid x:Name="Root" Margin="8" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Border Background="{DynamicResource BgBrush}" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" />
            </Border.Effect>
        </Border>
    <Border Padding="14,12,10,12" CornerRadius="10"
            Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/app.ico" Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                <WrapPanel x:Name="ActionsPanel" Margin="0,10,0,0" />
            </StackPanel>
            <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                    Margin="6,-4,0,0" ToolTip="關閉" Click="Close_Click" />
        </Grid>
    </Border>
    </Grid>
    </Grid>
</Window>
