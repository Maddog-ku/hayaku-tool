<UserControl x:Class="HayakuBar.UI.DateRangePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- 輸入框的樣子：開始日期 ~ 結束日期 📅，點一下開日曆 -->
        <Border x:Name="Field" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="4" Padding="9,6,8,6" Cursor="Hand" MouseLeftButtonUp="Field_Click" Focusable="True"
                KeyDown="Field_KeyDown" ToolTip="點一下選日期">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StartText" VerticalAlignment="Center" />
                <TextBlock x:Name="Tilde" Grid.Column="1" Text="~" Margin="8,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="EndText" Grid.Column="2" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                           Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>
        </Border>

        <Popup x:Name="CalendarPopup" PlacementTarget="{Binding ElementName=Field}" Placement="Bottom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" Closed="Popup_Closed">
            <Border Margin="8" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14,10,14,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.18" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 左邊的月份：« ‹ 2026年 10月 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="«" Style="{StaticResource IconButton}" FontSize="14" ToolTip="上一年" Click="PrevYear_Click" />
                                <Button Content="‹" Style="{StaticResource IconButton}" FontSize="15" ToolTip="上個月" Click="PrevMonth_Click" />
                            </StackPanel>
                            <TextBlock x:Name="LeftTitle" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <!-- 右邊的月份：2026年 11月 › » -->
                        <Grid Grid.Column="2">
                            <TextBlock x:Name="RightTitle" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="›" Style="{StaticResource IconButton}" FontSize="15" ToolTip="下個月" Click="NextMonth_Click" />
                                <Button Content="»" Style="{StaticResource IconButton}" FontSize="14" ToolTip="下一年" Click="NextYear_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <UniformGrid x:Name="LeftMonth" Columns="7" />
                        <UniformGrid x:Name="RightMonth" Grid.Column="2" Columns="7" />
                    </Grid>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,10,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Content="取消" Style="{StaticResource FlatButton}" Padding="14,5" Click="Cancel_Click" />
                                <Button Content="清除" Style="{StaticResource IconButton}" Padding="12,5" Margin="6,0,0,0"
                                        ToolTip="清除預計日期" Click="Clear_Click" />
                            </StackPanel>
                            <TextBlock x:Name="PickText" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" FontSize="12" />
                            <Button Content="套用日期" Style="{StaticResource PrimaryButton}" Padding="16,5" HorizontalAlignment="Right"
                                    Click="Apply_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
