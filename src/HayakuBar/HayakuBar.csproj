<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HayakuBar</RootNamespace>
    <AssemblyName>HayakuBar</AssemblyName>
    <Version>1.0.0</Version>
    <Product>HayakuBar</Product>
    <Description>Hayaku 工時工作列小工具</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI 由 manifest 設定（WPF 為主），WinForms 只用在系統匣選單 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF 與 WinForms 同時開啟時避免型別撞名（Application、MessageBox…），WinForms 只在 TrayIcon 用別名引用 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HayakuBar.Tests" />
  </ItemGroup>

</Project>
