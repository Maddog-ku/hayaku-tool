// 唯讀的檢視視窗：投票（C# UI/PollWindow.cs）、問題回報全文（C# UI/FeedbackWindow.cs）、檔案預覽（C# UI/FilePreviewWindow.cs）。
import { Theme, PopupState, Motion, Button, ButtonKind, ScrollView, ProgressBar, Spinner, Card, TipArea } from "@hb/index.slint";
import { MutedText, StatusLine, PlainText, LinkButton, GroupLabel } from "../common.slint";
import { DialogBody, DialogButtons, DialogFade, DialogMotion, Section } from "dialog.slint";

export struct PollOptionRow {
    label: string,
    mine: bool,
    /// 「N 票」；看不到票數時空字串
    votes-text: string,
    has-votes: bool,
    /// 0–1，對最高票的比例
    ratio: float,
    voters: string,
}

export component PollWindow inherits Window {
    icon: @image-url("../../../hayakubar/assets/app.ico");
    in property <bool> loading: true;
    in property <string> question;
    in property <string> meta;
    in property <[PollOptionRow]> options;
    in property <bool> hidden-results;
    in property <string> error;
    callback dismiss();
    title: "投票";
    width: 460px;
    min-height: body.content-height;
    max-height: body.content-height;
    background: Theme.card;
    default-font-family: Theme.font-ui;
    default-font-size: 13px;
    always-on-top: true;
    forward-focus: body;
    body := DialogBody {
        cancel => {
            root.dismiss();
        }
        key-pressed(e) => {
            if e.text == Key.Return {
                root.dismiss();
                return EventResult.accept;
            }
            EventResult.reject
        }
        if root.loading && root.error == "": Section {
            index: 0;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Spinner {
                    y: (parent.height - self.height) / 2;
                    width: 16px;
                    height: 16px;
                    color: Theme.muted;
                }
                Text {
                    text: "讀取中…";
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }
        }
        if !root.loading && root.error == "": Section {
            index: 0;
            VerticalLayout {
                spacing: 2px;
                Text {
                    text: root.question;
                    color: Theme.ink;
                    font-size: 15px;
                    font-weight: 700;
                    wrap: word-wrap;
                    // 中文長句沒有空白，換行文字的最小寬度會變成整句：不讓它把視窗撐寬（照樣換行）
                    min-width: 0px;
                }
                MutedText {
                    text: root.meta;
                }
            }
        }
        if !root.loading && root.error == "": VerticalLayout {
            spacing: 8px;
            padding-top: 4px;
            // 選項依序浮現
            for o[i] in root.options: Section {
                index: 1 + i;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: (o.mine ? "✓ " : "") + o.label;
                        color: Theme.ink;
                        font-size: Theme.fs-md;
                        font-weight: o.mine ? 700 : 400;
                        wrap: word-wrap;
                        // 中文長句沒有空白，換行文字的最小寬度會變成整句：不讓它把視窗撐寬（照樣換行）
                        min-width: 0px;
                    }
                    Text {
                        text: o.votes-text;
                        color: Theme.muted;
                        font-size: Theme.fs-md;
                        font-family: Theme.font-num;
                    }
                }
                if o.has-votes: ProgressBar {
                    grow-in: true;
                    height: 6px;
                    value: o.ratio;
                    fill: o.mine ? Theme.accent : Theme.ink;
                }
                if o.voters != "": MutedText {
                    text: o.voters;
                }
            }
            if root.hidden-results: Section {
                index: 1 + root.options.length;
                MutedText {
                    text: "這個投票設定投了才看得到結果。";
                    font-size: Theme.fs-md;
                }
            }
            Section {
                index: 2 + root.options.length;
                MutedText {
                    text: "要投票請到網頁（Hayaku 的 MCP 還不能投票）。";
                }
            }
        }
        StatusLine {
            text: root.error;
        }
        Section {
            index: 1;
            DialogButtons {
                Button {
                    text: "關閉";
                    kind: ButtonKind.primary;
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}

/// 灰底圓角框裡的可選取文字（C# Box）。
component TextBox {
    in property <string> text;
    height: txt.preferred-height + 20px;
    Rectangle {
        border-radius: Theme.radius-input;
        background: Theme.fill;
    }
    txt := PlainText {
        x: 12px;
        y: 10px;
        width: parent.width - 24px;
        text: root.text;
    }
}

export component FeedbackWindow inherits Window {
    icon: @image-url("../../../hayakubar/assets/app.ico");
    in property <string> window-title;
    in property <bool> loading: true;
    in property <string> error;
    in property <string> heading;
    in property <string> meta;
    in property <string> body-text;
    in property <string> resolution;
    in property <[string]> environment;
    in property <[string]> screenshots;
    in property <[string]> created-tasks;
    in property <[string]> history;
    callback open-screenshot(index: int);
    callback open-task(key: string);
    callback open-web();
    title: window-title;
    preferred-width: 640px;
    preferred-height: 620px;
    min-width: 420px;
    min-height: 320px;
    background: Theme.bg;
    default-font-family: Theme.font-ui;
    default-font-size: 13px;
    DialogFade {
        sv := ScrollView {
            content-height: card.preferred-height + 32px;
            content-width: self.visible-width;
            card := Card {
                x: 16px;
                y: 16px;
                width: sv.visible-width - 32px;
                height: self.preferred-height;
                content-padding: 22px;
                content-spacing: 8px;
                if root.loading && root.error == "": Section {
                    index: 0;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Spinner {
                            y: (parent.height - self.height) / 2;
                            width: 16px;
                            height: 16px;
                            color: Theme.muted;
                        }
                        Text {
                            text: "讀取中…";
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                }
                if root.error != "": Section {
                    index: 0;
                    Text {
                        text: root.error;
                        color: Theme.error;
                        wrap: word-wrap;
                        // 中文長句沒有空白，換行文字的最小寬度會變成整句：不讓它把視窗撐寬（照樣換行）
                        min-width: 0px;
                    }
                }
                if !root.loading: Section {
                    index: 0;
                    VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: root.heading;
                            color: Theme.ink;
                            font-size: Theme.fs-lg;
                            font-weight: 700;
                            wrap: word-wrap;
                            // 中文長句沒有空白，換行文字的最小寬度會變成整句：不讓它把視窗撐寬（照樣換行）
                            min-width: 0px;
                        }
                        MutedText {
                            text: root.meta;
                            font-size: Theme.fs-md;
                        }
                        TextBox {
                            text: root.body-text;
                        }
                    }
                }
                if !root.loading && root.resolution != "": Section {
                    index: 1;
                    VerticalLayout {
                        spacing: 6px;
                        padding-top: 8px;
                        GroupLabel {
                            text: "處理說明";
                        }
                        TextBox {
                            text: root.resolution;
                        }
                    }
                }
                if !root.loading && root.environment.length > 0: Section {
                    index: 2;
                    VerticalLayout {
                        spacing: 4px;
                        padding-top: 8px;
                        GroupLabel {
                            text: "環境";
                        }
                        for line in root.environment: MutedText {
                            text: line;
                            font-size: Theme.fs-md;
                        }
                    }
                }
                if !root.loading && root.screenshots.length > 0: Section {
                    index: 3;
                    VerticalLayout {
                        spacing: 6px;
                        padding-top: 8px;
                        GroupLabel {
                            text: "截圖（" + root.screenshots.length + "）";
                        }
                        FlexboxLayout {
                            spacing: 6px;
                            for s[i] in root.screenshots: Button {
                                text: s;
                                kind: ButtonKind.secondary;
                                font-size: 12.5px;
                                height: 34px;
                                horizontal-padding: 12px;
                                clicked => {
                                    root.open-screenshot(i);
                                }
                            }
                        }
                    }
                }
                if !root.loading && root.created-tasks.length > 0: Section {
                    index: 4;
                    VerticalLayout {
                        spacing: 6px;
                        padding-top: 8px;
                        GroupLabel {
                            text: "建立的任務";
                        }
                        FlexboxLayout {
                            spacing: 14px;
                            for k in root.created-tasks: LinkButton {
                                text: k;
                                clicked => {
                                    root.open-task(k);
                                }
                            }
                        }
                    }
                }
                if !root.loading && root.history.length > 0: Section {
                    index: 5;
                    VerticalLayout {
                        spacing: 4px;
                        padding-top: 8px;
                        GroupLabel {
                            text: "處理紀錄";
                        }
                        for h in root.history: MutedText {
                            text: h;
                            font-size: Theme.fs-md;
                        }
                    }
                }
                if !root.loading || root.error != "": Section {
                    index: 6;
                    HorizontalLayout {
                        padding-top: 10px;
                        alignment: start;
                        LinkButton {
                            text: "到網頁處理（轉任務、改狀態，從通知打開）↗";
                            clicked => {
                                root.open-web();
                            }
                        }
                    }
                }
            }
        }
    }
}

/// 預覽圖下方縮放列的小按鈕；active：目前就是這個狀態（符合視窗）。
component ZoomButton {
    in property <string> text;
    in property <string> tip;
    in property <bool> active;
    callback clicked();
    min-width: 30px;
    preferred-width: max(30px, label.preferred-width + 20px);
    height: 30px;
    TipArea {
        text: root.tip;
        Rectangle {
            border-radius: 15px;
            background: root.active ? Theme.ink : touch.pressed ? Theme.hover : touch.has-hover ? Theme.fill : transparent;
            animate background { duration: 120ms; }
            label := Text {
                text: root.text;
                color: root.active ? Theme.on-ink : Theme.ink;
                font-family: Theme.font-num;
                font-size: 12.5px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            touch := TouchArea {
                clicked => {
                    root.clicked();
                }
            }
        }
    }
}

export component FilePreviewWindow inherits Window {
    icon: @image-url("../../../hayakubar/assets/app.ico");
    in property <string> window-title;
    in property <bool> loading: true;
    /// 讀不到內容（第一段）
    in property <string> error;
    in property <bool> is-image;
    in property <image> picture;
    in property <string> text-content;
    in property <string> status;
    in property <bool> can-continue;
    in property <bool> can-copy;
    in property <bool> can-save;
    in property <bool> can-web;
    /// 跟上 Hayaku 1.5.10：現在是不是全螢幕（Rust 端切換後回寫）
    in property <bool> is-fullscreen;
    callback continue-reading();
    callback copy-text();
    callback save-image();
    callback open-web();
    callback dismiss();
    callback toggle-fullscreen();
    title: window-title;
    preferred-width: 860px;
    preferred-height: 640px;
    min-width: 420px;
    min-height: 320px;
    background: Theme.bg;
    default-font-family: Theme.font-ui;
    default-font-size: 13px;
    forward-focus: keys;
    keys := FocusScope {
        capture-key-pressed(e) => {
            if DialogMotion.closing {
                return EventResult.accept;
            }
            EventResult.reject
        }
        key-pressed(e) => {
            // 全螢幕時 Esc 先離開全螢幕，再按一次才關
            if e.text == Key.Escape {
                // 選單開著時只關選單（PopupState）
                if PopupState.esc-for-popup() {
                    return EventResult.reject;
                }
                if root.is-fullscreen {
                    root.toggle-fullscreen();
                } else {
                    root.dismiss();
                }
                return EventResult.accept;
            }
            // Ctrl＋Shift＋F 切換全螢幕（跟上 Hayaku 1.5.10）
            if e.modifiers.control && e.modifiers.shift && (e.text == "f" || e.text == "F") {
                root.toggle-fullscreen();
                return EventResult.accept;
            }
            EventResult.reject
        }
        DialogFade {
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 8px;
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-card - 6px;
                    background: Theme.card;
                    clip: true;
                    if root.loading && root.error == "": HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        Spinner {
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                            color: Theme.muted;
                        }
                        Text {
                            text: "讀取中…";
                            color: Theme.muted;
                            vertical-alignment: center;
                        }
                    }
                    if root.error != "": Text {
                        x: 20px;
                        y: 18px;
                        width: parent.width - 40px;
                        text: root.error;
                        color: Theme.error;
                        wrap: word-wrap;
                    }
                    if !root.loading && root.is-image: Rectangle {
                        // 讀好的內容往上浮出＋淡入
                        property <float> t: 0;
                        init => {
                            self.t = 1;
                        }
                        animate t {
                            duration: Motion.enter-dur;
                            easing: Motion.out;
                        }
                        y: (1 - self.t) * Motion.rise;
                        opacity: self.t;
                        // 跟上 Hayaku 1.5.7：滾輪縮放、拖曳移動、雙擊切換「符合視窗」與 100%，下方有縮放按鈕
                        view := Rectangle {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            clip: true;
                            property <length> img-w: max(1px, root.picture.width * 1px);
                            property <length> img-h: max(1px, root.picture.height * 1px);
                            // 符合視窗：大圖縮到整張放得下，小圖照原尺寸（不放大，跟原本一樣）
                            property <float> fit-scale: min(1, self.width / self.img-w, self.height / self.img-h);
                            property <bool> fit: true;
                            property <float> zoom: 1;
                            property <float> scale: self.fit ? self.fit-scale : self.zoom;
                            property <length> shown-w: self.img-w * self.scale;
                            property <length> shown-h: self.img-h * self.scale;
                            // 圖比可見區大時才能拖：圖中心離可見區中心最多移到圖的邊碰到可見區的邊
                            property <length> limit-x: max(0px, (self.shown-w - self.width) / 2);
                            property <length> limit-y: max(0px, (self.shown-h - self.height) / 2);
                            property <bool> can-pan: self.limit-x > 0px || self.limit-y > 0px;
                            // 圖中心離可見區中心的位移（拖曳移動）；拉小視窗時照樣夾在範圍內
                            property <length> pan-x: 0px;
                            property <length> pan-y: 0px;
                            property <length> drag-x: 0px;
                            property <length> drag-y: 0px;
                            property <int> percent: round(self.scale * 100);
                            // 改縮放比例；(mx, my) 那一點縮放後留在原地（滾輪、雙擊對準游標，按鈕對準中間）
                            function zoom-to(s: float, mx: length, my: length) {
                                let s2 = clamp(s, 0.05, 8);
                                let old-x = (self.width - self.shown-w) / 2 + clamp(self.pan-x, -self.limit-x, self.limit-x);
                                let old-y = (self.height - self.shown-h) / 2 + clamp(self.pan-y, -self.limit-y, self.limit-y);
                                let new-w = self.img-w * s2;
                                let new-h = self.img-h * s2;
                                let new-x = mx - (mx - old-x) / self.scale * s2;
                                let new-y = my - (my - old-y) / self.scale * s2;
                                let lx = max(0px, (new-w - self.width) / 2);
                                let ly = max(0px, (new-h - self.height) / 2);
                                self.pan-x = clamp(new-x - (self.width - new-w) / 2, -lx, lx);
                                self.pan-y = clamp(new-y - (self.height - new-h) / 2, -ly, ly);
                                self.zoom = s2;
                                self.fit = false;
                            }
                            function show-fit() {
                                self.fit = true;
                                self.pan-x = 0px;
                                self.pan-y = 0px;
                            }
                            pic := Image {
                                width: view.shown-w;
                                height: view.shown-h;
                                x: (view.width - self.width) / 2 + clamp(view.pan-x, -view.limit-x, view.limit-x);
                                y: (view.height - self.height) / 2 + clamp(view.pan-y, -view.limit-y, view.limit-y);
                                source: root.picture;
                                image-fit: fill;
                                image-rendering: smooth;
                            }
                            pan-area := TouchArea {
                                mouse-cursor: !view.can-pan ? MouseCursor.default : self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                pointer-event(e) => {
                                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                                        view.drag-x = clamp(view.pan-x, -view.limit-x, view.limit-x);
                                        view.drag-y = clamp(view.pan-y, -view.limit-y, view.limit-y);
                                    }
                                }
                                moved => {
                                    if self.pressed && view.can-pan {
                                        view.pan-x = clamp(view.drag-x + self.mouse-x - self.pressed-x, -view.limit-x, view.limit-x);
                                        view.pan-y = clamp(view.drag-y + self.mouse-y - self.pressed-y, -view.limit-y, view.limit-y);
                                    }
                                }
                                double-clicked => {
                                    if view.fit && view.fit-scale < 1 {
                                        view.zoom-to(1, self.mouse-x, self.mouse-y);
                                    } else if view.fit {
                                        // 小圖「符合視窗」本來就是 100%：雙擊放大到兩倍
                                        view.zoom-to(2, self.mouse-x, self.mouse-y);
                                    } else {
                                        view.show-fit();
                                    }
                                }
                                // 滾輪往上放大、往下縮小（觸控板一點一點捲也平順）
                                scroll-event(e) => {
                                    if e.delta-y != 0px {
                                        view.zoom-to(view.scale * pow(1.0025, e.delta-y / 1px), self.mouse-x, self.mouse-y);
                                    }
                                    EventResult.accept
                                }
                            }
                            // 下方的縮放按鈕
                            Rectangle {
                                width: zoom-bar.preferred-width;
                                height: 36px;
                                x: (parent.width - self.width) / 2;
                                y: parent.height - self.height - 10px;
                                border-radius: 18px;
                                background: Theme.card;
                                border-width: 1px;
                                border-color: Theme.line;
                                drop-shadow-color: Theme.shadow;
                                drop-shadow-blur: 12px;
                                drop-shadow-offset-y: 2px;
                                zoom-bar := HorizontalLayout {
                                    padding: 3px;
                                    spacing: 2px;
                                    ZoomButton {
                                        text: "－";
                                        tip: "縮小";
                                        clicked => {
                                            view.zoom-to(view.scale / 1.25, view.width / 2, view.height / 2);
                                        }
                                    }
                                    ZoomButton {
                                        text: view.percent + "%";
                                        tip: "切換「符合視窗」與 100%（也可以雙擊圖片）";
                                        min-width: 58px;
                                        clicked => {
                                            if view.fit {
                                                view.zoom-to(1, view.width / 2, view.height / 2);
                                            } else {
                                                view.show-fit();
                                            }
                                        }
                                    }
                                    ZoomButton {
                                        text: "＋";
                                        tip: "放大";
                                        clicked => {
                                            view.zoom-to(view.scale * 1.25, view.width / 2, view.height / 2);
                                        }
                                    }
                                    ZoomButton {
                                        text: "符合視窗";
                                        tip: "整張放進視窗";
                                        active: view.fit;
                                        clicked => {
                                            view.show-fit();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if !root.loading && !root.is-image: Rectangle {
                        // 讀好的內容往上浮出＋淡入
                        property <float> t: 0;
                        init => {
                            self.t = 1;
                        }
                        animate t {
                            duration: Motion.enter-dur;
                            easing: Motion.out;
                        }
                        y: (1 - self.t) * Motion.rise;
                        opacity: self.t;
                        text-sv := ScrollView {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            content-height: txt.preferred-height + 32px;
                            content-width: self.visible-width;
                            txt := PlainText {
                                x: 16px;
                                y: 14px;
                                width: text-sv.visible-width - 32px;
                                text: root.text-content;
                                font-size: 13.5px;
                            }
                        }
                    }
                }
                if root.status != "": Section {
                    index: 1;
                    Text {
                        text: root.status;
                        color: Theme.muted;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                        // 中文長句沒有空白，換行文字的最小寬度會變成整句：不讓它把視窗撐寬（照樣換行）
                        min-width: 0px;
                    }
                }
                Section {
                    index: 1;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        if root.can-continue: Button {
                            text: "繼續讀";
                            kind: ButtonKind.primary;
                            clicked => {
                                root.continue-reading();
                            }
                        }
                        if root.can-copy: Button {
                            text: "複製文字";
                            kind: ButtonKind.secondary;
                            clicked => {
                                root.copy-text();
                            }
                        }
                        if root.can-save: Button {
                            text: "另存圖片…";
                            kind: ButtonKind.secondary;
                            clicked => {
                                root.save-image();
                            }
                        }
                        if root.can-web: Button {
                            text: "到網頁下載 ↗";
                            kind: ButtonKind.secondary;
                            clicked => {
                                root.open-web();
                            }
                        }
                        TipArea {
                            text: root.is-fullscreen ? "回到視窗（Ctrl＋Shift＋F 或 Esc）" : "整個螢幕看（Ctrl＋Shift＋F）";
                            Button {
                                text: root.is-fullscreen ? "離開全螢幕" : "全螢幕";
                                kind: ButtonKind.secondary;
                                clicked => {
                                    root.toggle-fullscreen();
                                }
                            }
                        }
                        Button {
                            text: "關閉";
                            kind: ButtonKind.secondary;
                            clicked => {
                                root.dismiss();
                            }
                        }
                    }
                }
            }
        }
    }
}
