// 按鈕：主要／次要／外框／強調／幽靈；圖示按鈕。按下快速壓縮，放開以彈簧回彈。
import { Theme, Motion } from "../theme.slint";
import { Icon } from "icons.slint";

export enum ButtonKind {
    /// ink 底
    primary,
    /// 淺灰（fill）底
    secondary,
    /// 1.5px 外框
    outline,
    /// 橘底
    accent,
    /// 透明底
    ghost,
    /// 卡片底＋陰影（數字加減的減號）
    surface,
}

component PressScale inherits Rectangle {
    in property <bool> pressed;
    in property <float> depth: 0.94;
    transform-scale: pressed ? depth : 1;
    animate transform-scale {
        duration: root.pressed ? Motion.press-dur : Motion.spring-dur;
        easing: root.pressed ? Motion.press : Motion.spring;
    }
}

export component Button {
    in property <string> text;
    /// 圖示 path（Icons.xxx），空字串不顯示
    in property <string> icon;
    in property <bool> icon-after: false;
    in property <ButtonKind> kind: ButtonKind.primary;
    in property <bool> enabled: true;
    in property <length> font-size: 13px;
    in property <length> horizontal-padding: 16px;
    callback clicked;
    out property <color> fg: kind == ButtonKind.primary ? Theme.on-ink : kind == ButtonKind.accent ? Theme.on-accent : Theme.ink;
    property <color> bg: kind == ButtonKind.primary ? Theme.ink : kind == ButtonKind.secondary ? Theme.fill : kind == ButtonKind.accent ? Theme.accent : kind == ButtonKind.surface ? Theme.card : transparent;
    height: 38px;
    min-width: self.height;
    preferred-width: hl.preferred-width;
    horizontal-stretch: 0;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { ta.clicked(); }
    PressScale {
        pressed: ta.pressed;
        background: root.bg;
        border-radius: self.height / 2;
        border-width: root.kind == ButtonKind.outline ? 1.5px : 0px;
        border-color: Theme.ink;
        drop-shadow-color: root.kind == ButtonKind.surface ? Theme.shadow : transparent;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        animate background { duration: 300ms; }
        Rectangle {
            border-radius: parent.border-radius;
            background: ta.has-hover ? (root.kind == ButtonKind.primary ? Theme.on-ink.with-alpha(0.1) : Theme.ink.with-alpha(0.05)) : transparent;
            animate background { duration: 200ms; }
        }
        hl := HorizontalLayout {
            padding-left: root.horizontal-padding;
            padding-right: root.horizontal-padding;
            spacing: 6px;
            alignment: center;
            if root.icon != "" && !root.icon-after: Icon {
                y: (parent.height - self.height) / 2;
                path: root.icon;
                color: root.fg;
                width: 18px;
                height: 18px;
                weight: 2.2;
            }
            if root.text != "": Text {
                text: root.text;
                color: root.fg;
                font-size: root.font-size;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.icon != "" && root.icon-after: Icon {
                y: (parent.height - self.height) / 2;
                path: root.icon;
                color: root.fg;
                width: 18px;
                height: 18px;
                weight: 2.2;
            }
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

/// 方形圖示按鈕（設計稿 .ib：40×40、圓角 14）
export component IconButton {
    in property <string> icon;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> enabled: true;
    in property <float> weight: 2.2;
    in property <length> icon-size: 18px;
    in property <length> radius: 14px;
    /// 按下時縮放比例
    in property <float> depth: 0.88;
    in property <string> label;
    callback clicked;
    out property <color> fg: kind == ButtonKind.primary ? Theme.on-ink : kind == ButtonKind.accent ? Theme.on-accent : Theme.ink;
    width: 40px;
    height: 40px;
    opacity: enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { ta.clicked(); }
    PressScale {
        pressed: ta.pressed;
        depth: root.depth;
        border-radius: root.radius;
        background: root.kind == ButtonKind.primary ? Theme.ink : root.kind == ButtonKind.secondary ? Theme.fill : root.kind == ButtonKind.accent ? Theme.accent : root.kind == ButtonKind.surface ? Theme.card : transparent;
        border-width: root.kind == ButtonKind.outline ? 1.5px : 0px;
        border-color: Theme.ink;
        drop-shadow-color: root.kind == ButtonKind.surface ? Theme.shadow : transparent;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        animate background { duration: 300ms; }
        Rectangle {
            border-radius: parent.border-radius;
            background: ta.has-hover ? (root.kind == ButtonKind.primary ? Theme.on-ink.with-alpha(0.1) : Theme.ink.with-alpha(0.05)) : transparent;
            animate background { duration: 200ms; }
        }
        Icon {
            path: root.icon;
            color: root.fg;
            weight: root.weight;
            width: root.icon-size;
            height: root.icon-size;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
