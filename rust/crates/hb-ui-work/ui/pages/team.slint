// 工作台「團隊狀況」頁（對應 C# UI/Work/TeamPage.xaml(.cs)）。
// 契約：匯出 global TeamPageData（Rust 端用 window.global::<TeamPageData>() 讀寫）與 component TeamPage；
// 這兩個名稱與檔名不可改（workspace.slint 依此匯入）。
// 團隊今天的狀況：誰在線、誰請假、誰正在計時哪個任務（專案顏色、標上層任務）。
import { Theme, ScrollView, Avatar, AvatarTone, Tip } from "@hb/index.slint";
import { StatusLine, PageTitle } from "@hbc/index.slint";
import { PageButton, ItemCard } from "w3-common.slint";

/// 一筆正在計時（C# TeamTimingVm）：dot 是專案的顏色，parent-prefix 是「上層任務 › 」。
export struct TeamTiming {
    key: string,
    title: string,
    parent-prefix: string,
    since: string,
    tip: string,
    can-open: bool,
    dot: color,
}

/// 一個人（C# TeamMemberVm）。dot：0 請假（警告色）、1 在線（綠）、2 離線（線條色）；state-tone：0 警告、1 計時中、2 淡色。
export struct TeamPerson {
    name: string,
    initial: string,
    job: string,
    dot: int,
    state: string,
    state-tone: int,
    timing: [TeamTiming],
}

export global TeamPageData {
    in-out property <bool> loading;
    in-out property <string> counts;
    in-out property <string> status;
    in-out property <int> status-tone;
    in-out property <[TeamPerson]> left;
    in-out property <[TeamPerson]> right;
    callback reload();
    callback timing-clicked(string);
}

component PersonCard inherits ItemCard {
    in property <TeamPerson> person;
    pad-x: 14px;
    pad-y: 12px;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 34px;
            height: 34px;
            Avatar {
                size: 34px;
                text: root.person.initial;
                tone: AvatarTone.outline;
            }
            Rectangle {
                x: parent.width - 10px;
                y: parent.height - 10px;
                width: 10px;
                height: 10px;
                border-radius: 5px;
                border-width: 2px;
                border-color: Theme.fill;
                background: root.person.dot == 0 ? Theme.warn : root.person.dot == 1 ? Theme.run : Theme.line;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.person.name;
                color: Theme.ink;
                font-weight: 600;
                font-size: Theme.fs-base;
                overflow: elide;
            }
            if root.person.job != "": Text {
                text: root.person.job;
                color: Theme.muted;
                font-size: Theme.fs-sm;
                overflow: elide;
            }
        }
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: 22px;
            width: state.preferred-width + 18px;
            border-radius: 11px;
            background: Theme.card;
            state := Text {
                text: root.person.state;
                font-size: 11px;
                font-weight: 600;
                color: root.person.state-tone == 0 ? Theme.warn : root.person.state-tone == 1 ? Theme.run : Theme.muted;
            }
        }
    }
    if root.person.timing.length > 0: VerticalLayout {
        padding-left: 44px;
        padding-top: 4px;
        spacing: 2px;
        for t in root.person.timing: Rectangle {
            height: line.preferred-height + 4px;
            line := HorizontalLayout {
                spacing: 0px;
                Text {
                    text: "● ";
                    color: t.dot;
                    font-size: 9px;
                    vertical-alignment: center;
                }
                Text {
                    text: t.key + " ";
                    color: Theme.ink;
                    font-weight: 600;
                    font-size: Theme.fs-md;
                    vertical-alignment: center;
                }
                Text {
                    text: t.parent-prefix;
                    color: Theme.muted;
                    font-size: Theme.fs-md;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: t.title;
                    color: Theme.ink;
                    font-size: Theme.fs-md;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: t.since == "" ? "" : " " + t.since;
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
            if t.tip != "": Rectangle {
                Tooltip {
                    Tip {
                        text: t.tip;
                    }
                }
            }
            TouchArea {
                enabled: t.can-open;
                mouse-cursor: t.can-open ? pointer : default;
                clicked => {
                    TeamPageData.timing-clicked(t.key);
                }
            }
        }
    }
}

export component TeamPage inherits Rectangle {
    VerticalLayout {
        padding-left: 24px;
        padding-right: 24px;
        padding-top: 18px;
        padding-bottom: 16px;
        spacing: 8px;
        HorizontalLayout {
            PageTitle {
                text: "團隊狀況";
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            PageButton {
                text: "⟳ 重新整理";
                clicked => {
                    TeamPageData.reload();
                }
            }
        }
        Text {
            text: TeamPageData.counts;
            color: Theme.muted;
            font-size: Theme.fs-md;
        }
        StatusLine {
            text: TeamPageData.status;
            tone: TeamPageData.status-tone;
        }
        ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                padding-top: 6px;
                padding-right: 8px;
                spacing: 8px;
                alignment: stretch;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: start;
                    for p in TeamPageData.left: PersonCard {
                        person: p;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: start;
                    for p in TeamPageData.right: PersonCard {
                        person: p;
                    }
                }
            }
        }
    }
}
