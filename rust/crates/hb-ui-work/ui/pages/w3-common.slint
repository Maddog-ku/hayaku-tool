// 會議、聊天、筆記、團隊空間、論壇、團隊狀況、專案動態、請假頁共用的小元件
// （對應 C# UI/Work/PageParts.cs 與 MarkdownTable.Attach／InsertButton 的介面部分）。
// 外觀沿用 hb-ui-kit 的 Theme 與微互動：冷灰底卡片、黑主色、橘強調、彈簧緩動（reduce-motion 時不回彈）。
import { Theme, Motion, Button, ButtonKind, ScrollView, TipArea, Tip } from "@hb/index.slint";
import { TextArea, MutedText } from "@hbc/index.slint";
import { Appear, CardShadow } from "../shared/anim.slint";

/// 清單的一列（C# PageParts.Row）：粗體標題＋淡色說明。depth／expandable／expanded 給頁面樹用；
/// accent：標題用強調色（檔案連結）；tip：滑過的提示。
export struct W3Row {
    id: string,
    title: string,
    meta: string,
    tip: string,
    depth: int,
    expandable: bool,
    expanded: bool,
    accent: bool,
}

/// 勾選項目（參加者）。
export struct W3Check {
    id: string,
    text: string,
    checked: bool,
}

/// 頁面上的按鈕（C# PageParts.Button：FlatButton／PrimaryButton）：比 hb Button 矮一點；busy 時顯示「處理中…」並停用。
export component PageButton {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> busy: false;
    in property <string> tip;
    callback clicked;
    horizontal-stretch: 0;
    TipArea {
        text: root.tip;
        Button {
            height: 34px;
            text: root.busy ? "處理中…" : root.text;
            kind: root.primary ? ButtonKind.primary : ButtonKind.secondary;
            enabled: root.enabled && !root.busy;
            horizontal-padding: 14px;
            clicked => {
                root.clicked();
            }
        }
    }
}

/// 小的文字按鈕（C# IconButton 樣式的「開啟」「離開」「✕」）。
export component SmallButton {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <bool> primary: false;
    callback clicked;
    horizontal-stretch: 0;
    TipArea {
        text: root.tip;
        Rectangle {
            height: 30px;
            min-width: lbl.preferred-width + 16px;
            border-radius: 15px;
            background: root.primary ? Theme.ink : ta.has-hover ? Theme.hover : transparent;
            opacity: root.enabled ? 1 : 0.45;
            animate background { duration: 200ms; }
            lbl := Text {
                // 按下往下沉一點，放開彈回（軟體繪製不支援縮放）
                property <length> sink: ta.pressed && !Theme.reduce-motion ? 1.5px : 0px;
                y: self.sink;
                height: parent.height;
                animate sink {
                    duration: ta.pressed ? Motion.press-dur : Motion.spring-dur;
                    easing: ta.pressed ? Motion.press : Motion.spring;
                }
                text: root.text;
                color: root.primary ? Theme.on-ink : Theme.ink;
                font-size: Theme.fs-sm;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => {
                    root.clicked();
                }
            }
        }
    }
}

/// 分頁切換（同 hb-ui-kit Segmented 的外觀），每一格可以有自己的提示（C# RadioButton 的 ToolTip）。
export component TipSegmented {
    in property <[string]> items;
    in property <[string]> tips;
    in-out property <int> current: 0;
    in property <length> font-size: 13px;
    in property <length> item-padding: 16px;
    callback selected(index: int);
    property <length> ind-x;
    property <length> ind-w;
    property <bool> ready;
    height: 38px;
    horizontal-stretch: 0;
    preferred-width: hl.preferred-width;
    min-width: hl.min-width;
    Timer {
        interval: 250ms;
        running: !root.ready;
        triggered => {
            root.ready = true;
        }
    }
    Rectangle {
        background: Theme.fill;
        border-radius: self.height / 2;
    }
    Rectangle {
        x: root.ind-x;
        y: 4px;
        width: root.ind-w;
        height: root.height - 8px;
        border-radius: self.height / 2;
        background: Theme.ink;
        animate x, width {
            duration: root.ready ? Motion.spring-dur : 0ms;
            easing: Motion.spring;
        }
    }
    hl := HorizontalLayout {
        padding: 4px;
        alignment: start;
        for item[i] in root.items: Rectangle {
            property <bool> on: i == root.current;
            horizontal-stretch: 0;
            min-width: lbl.preferred-width + 2 * root.item-padding;
            init => {
                if self.on {
                    root.ind-x = self.x;
                    root.ind-w = self.width;
                }
            }
            changed on => {
                if self.on {
                    root.ind-x = self.x;
                    root.ind-w = self.width;
                }
            }
            changed x => {
                if self.on {
                    root.ind-x = self.x;
                }
            }
            changed width => {
                if self.on {
                    root.ind-w = self.width;
                }
            }
            accessible-role: tab;
            accessible-label: item;
            accessible-item-selected: self.on;
            Rectangle {
                // 按下往下沉一點，放開彈回（軟體繪製不支援縮放）
                property <length> sink: ta.pressed && !Theme.reduce-motion ? 1.5px : 0px;
                y: self.sink;
                animate sink {
                    duration: ta.pressed ? Motion.press-dur : Motion.spring-dur;
                    easing: ta.pressed ? Motion.press : Motion.spring;
                }
                lbl := Text {
                    text: item;
                    color: on ? Theme.on-ink : Theme.muted;
                    font-size: root.font-size;
                    font-weight: 600;
                    animate color { duration: 300ms; }
                }
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    if root.current != i {
                        root.current = i;
                        root.selected(i);
                    }
                }
            }
            if i < root.tips.length && root.tips[i] != "": Rectangle {
                Tooltip {
                    Tip {
                        text: root.tips[i];
                    }
                }
            }
        }
    }
}

/// 清單的一列：選中時淡橘底；頁面樹時依 depth 縮排，可展開的前面有 ▸／▾。
export component ListRow {
    in property <W3Row> data;
    in property <bool> selected;
    callback clicked;
    callback double-clicked;
    callback toggled;
    min-height: col.preferred-height + 10px;
    Rectangle {
        border-radius: 12px;
        background: root.selected ? Theme.selected : ta.has-hover ? Theme.hover : transparent;
        animate background { duration: 180ms; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        double-clicked => {
            root.double-clicked();
        }
    }
    HorizontalLayout {
        padding-left: 8px + root.data.depth * 16px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 4px;
        if root.data.expandable: Rectangle {
            width: 16px;
            Text {
                text: root.data.expanded ? "▾" : "▸";
                color: Theme.muted;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggled();
                }
            }
        }
        if root.data.depth > 0 && !root.data.expandable: Rectangle {
            width: 16px;
        }
        col := VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.data.title;
                color: root.data.accent ? Theme.accent-ink : Theme.ink;
                font-size: Theme.fs-md;
                font-weight: 600;
                overflow: elide;
            }
            if root.data.meta != "": Text {
                text: root.data.meta;
                color: Theme.muted;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
    if root.data.tip != "": Rectangle {
        Tooltip {
            Tip {
                text: root.data.tip;
            }
        }
    }
}

/// 捲動的清單（C# PageParts.List）：current 是選中的列（-1 沒選）。
export component RowList {
    in property <[W3Row]> rows;
    in property <int> current: -1;
    callback selected(index: int);
    callback activated(index: int);
    callback toggled(index: int);
    sv := ScrollView {
        // 內容寬度跟著可見寬度（換行的長文字不會把內容撐寬、被右邊切掉）
        content-width: self.visible-width;
        VerticalLayout {
            padding-right: 6px;
            spacing: 1px;
            alignment: start;
            // 載入、切換時依序浮現（ListReveal 開著才播）
            for row[i] in root.rows: Appear {
                index: i;
                rise: 6px;
                ListRow {
                    data: row;
                    selected: i == root.current;
                    clicked => {
                        root.selected(i);
                    }
                    double-clicked => {
                        root.activated(i);
                    }
                    toggled => {
                        root.toggled(i);
                    }
                }
            }
        }
    }
}

/// 唯讀、可選取複製的內文（C# PageParts.Reader：PlainText、13px）。
/// 包一層、依實際寬度算高度：直接用會換行的 TextInput 放在 for／if 裡時，Slint 估的高度會偏少，
/// 很長的訊息最後幾段捲不到（同 hayakubar 的 WrapText）。
export component Reader {
    in property <string> text;
    in property <length> font-size: 13px;
    min-width: min(input.min-width, 80px);
    preferred-width: input.preferred-width;
    min-height: input.preferred-height;
    preferred-height: input.preferred-height;
    input := TextInput {
        width: root.width;
        height: root.height;
        text: root.text;
        read-only: true;
        single-line: false;
        wrap: word-wrap;
        color: Theme.ink;
        font-size: root.font-size;
        selection-background-color: Theme.accent-soft;
        selection-foreground-color: Theme.ink;
    }
}

/// 淡底圓角的區塊（C# SubtleBrush Border：會議紀錄、論壇回應）。
export component SubtleBox inherits Rectangle {
    in property <length> pad: 10px;
    background: Theme.fill;
    border-radius: 14px;
    VerticalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        padding-top: root.pad - 2px;
        padding-bottom: root.pad - 2px;
        spacing: 2px;
        @children
    }
}

/// 項目卡片（C# Card 樣式）：淡灰底、大圓角；selected 時淡橘底；可點時滑過加深。
export component ItemCard inherits Rectangle {
    in property <bool> selected;
    in property <bool> clickable: false;
    in property <length> pad-x: 16px;
    in property <length> pad-y: 10px;
    callback clicked;
    background: root.selected ? Theme.selected : (root.clickable && cta.has-hover) ? Theme.hover : Theme.fill;
    border-radius: 20px;
    animate background { duration: 220ms; }
    cta := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
    VerticalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: 4px;
        @children
    }
}

/// 勾選項目自動換行排列（C# WrapPanel 裡的 CheckBox）：固定欄寬 item-width。
export component CheckWrap {
    in-out property <[W3Check]> items;
    in property <length> item-width: 150px;
    in property <length> row-height: 28px;
    callback toggled(index: int, checked: bool);
    property <int> cols: max(1, floor(self.width / root.item-width));
    property <length> h: root.items.length == 0 ? 0px : ceil(root.items.length / root.cols) * root.row-height;
    min-height: root.h;
    preferred-height: root.h;
    max-height: root.h;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    for item[i] in root.items: Rectangle {
        x: mod(i, root.cols) * root.item-width;
        y: floor(i / root.cols) * root.row-height;
        width: root.item-width - 8px;
        height: root.row-height;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                border-radius: 6px;
                background: item.checked ? Theme.ink : transparent;
                border-width: item.checked ? 0px : 1.5px;
                border-color: Theme.faint;
                animate background { duration: 200ms; }
                Text {
                    text: "✓";
                    visible: item.checked;
                    color: Theme.on-ink;
                    font-size: 12px;
                    font-weight: 700;
                }
            }
            Text {
                text: item.text;
                color: Theme.ink;
                font-size: Theme.fs-md;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.toggled(i, !item.checked);
            }
        }
    }
}

/// 確認視窗（C# MessageBox.Show(OKCancel)）：蓋在頁面上，按「確定」才執行。
export component ConfirmOverlay inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> message;
    callback ok();
    callback cancel();
    // 打開：底色淡入、卡片往上浮出（340ms）；關閉反向淡出（160ms），播完才不顯示
    visible: root.open || root.t > 0.01;
    border-radius: Theme.radius-card;
    property <float> t: root.open ? 1 : 0;
    animate t {
        duration: root.open ? (Theme.reduce-motion ? 160ms : 340ms) : 160ms;
        easing: root.open ? Motion.soft : Motion.out;
    }
    changed open => {
        if root.open {
            keys.focus();
        }
    }
    Rectangle {
        border-radius: Theme.radius-card;
        background: Theme.dark ? #00000080 : #0E0F1333;
        opacity: clamp(root.t, 0, 1);
    }
    TouchArea { }
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                root.cancel();
                return accept;
            }
            if e.text == Key.Return {
                root.ok();
                return accept;
            }
            reject
        }
        // 假陰影（軟體繪製畫不出 drop-shadow）
        CardShadow {
            x: card.x;
            y: card.y;
            width: card.width;
            height: card.height;
            radius: Theme.radius-card;
            strength: clamp(root.t, 0, 1);
        }
        card := Rectangle {
            width: min(440px, root.width - 40px);
            height: min(lay.preferred-height, root.height - 32px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2 + (Theme.reduce-motion ? 0px : (1 - root.t) * 24px);
            opacity: clamp(root.t * 1.5, 0, 1);
            clip: true;
            background: Theme.card;
            border-radius: Theme.radius-card;
            drop-shadow-color: Theme.shadow;
            drop-shadow-blur: 30px;
            drop-shadow-offset-y: 10px;
            lay := VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: root.title;
                    color: Theme.ink;
                    font-size: Theme.fs-lg;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                Text {
                    text: root.message;
                    color: Theme.ink;
                    font-size: Theme.fs-md;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    PageButton {
                        text: "確定";
                        primary: true;
                        clicked => {
                            root.ok();
                        }
                    }
                    PageButton {
                        text: "取消";
                        clicked => {
                            root.cancel();
                        }
                    }
                }
            }
        }
    }
}

/// 多行輸入框（C# PageParts.Input(multiline) ＋ MarkdownTable.Attach）：從 Excel（或 Google 試算表）貼上時改貼成 Markdown 表格；
/// insert-template() 是〔▦ 表格〕按鈕。表格與插入位置由 Rust 算（md-table／md-insert／md-cursor 由頁面接到自己的 global）。
/// enter-sends：Enter 送出、Shift+Enter 換行（聊天）。
export component MdArea {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> tables: true;
    in property <bool> enter-sends: false;
    in property <length> font-size: Theme.fs-md;
    /// kind 0：空白表格；1：剪貼簿是試算表時的 Markdown 表格（不是回空字串）
    callback md-table(kind: int) -> string;
    /// 插入後的整段文字（selection a..b，位元組位移）
    callback md-insert(text: string, a: int, b: int, table: string) -> string;
    /// 插入後的游標位置（位元組位移）
    callback md-cursor(text: string, a: int, b: int, table: string) -> int;
    callback send();
    callback edited(text: string);
    forward-focus: area;
    public function insert-template() {
        root.insert(root.md-table(0));
    }
    function insert(table: string) {
        if table == "" {
            return;
        }
        let a = min(area.cursor-offset, area.anchor-offset);
        let b = max(area.cursor-offset, area.anchor-offset);
        let c = root.md-cursor(root.text, a, b, table);
        root.text = root.md-insert(root.text, a, b, table);
        area.focus();
        area.set-selection(c, c);
    }
    FocusScope {
        capture-key-pressed(e) => {
            if root.enter-sends && e.text == Key.Return && !e.modifiers.shift && !e.modifiers.control && !e.modifiers.alt {
                root.send();
                return accept;
            }
            if root.tables && ((e.modifiers.control && !e.modifiers.alt && (e.text == "v" || e.text == "V" || e.text == "\u{16}")) || (e.modifiers.shift && e.text == Key.Insert)) {
                let t = root.md-table(1);
                if t != "" {
                    root.insert(t);
                    return accept;
                }
            }
            reject
        }
        area := TextArea {
            width: parent.width;
            height: parent.height;
            text <=> root.text;
            placeholder: root.placeholder;
            enabled: root.enabled;
            font-size: root.font-size;
            edited(t) => {
                root.edited(t);
            }
        }
    }
}

/// 分組標題（C# GroupLabel）。
export component W3Group inherits Text {
    color: Theme.ink;
    font-size: Theme.fs-md;
    font-weight: 700;
}

/// 置中的淡色訊息（清單空白、讀取中）。
export component CenterNote inherits Text {
    // 出現時淡入（讀取中、清單空白）
    property <float> t: 0;
    init => {
        t = 1;
    }
    animate t {
        duration: Theme.reduce-motion ? 0ms : 260ms;
        easing: Motion.out;
    }
    opacity: root.t;
    color: Theme.muted;
    font-size: Theme.fs-md;
    horizontal-alignment: center;
    vertical-alignment: center;
    wrap: word-wrap;
}
