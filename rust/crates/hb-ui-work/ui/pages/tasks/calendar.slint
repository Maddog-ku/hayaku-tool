// 我的任務：日曆與甘特圖共用的任務條、工具列，以及日曆（C# TasksPage.Schedule.cs、TasksPage.Calendar.cs）。
// 月曆星期一開頭：任務從預計開始畫到預計結束，拖到別天起訖一起平移（天數不變）；
// 沒有預計日期的列在右邊，拖到日期上就把起訖都設成那天。放不下的那天顯示「+N」，點了選要打開哪個。
import { Theme, Motion, ScrollView, Tip } from "@hb/index.slint";
import { TaskMenuArea } from "@hbc/index.slint";
import { SmallButton, ListReveal } from "../../shared/index.slint";
import { TasksPageData, TkBar, TkPick } from "data.slint";

/// 剛拖拉放開的任務（日曆、甘特重畫後那一條從上面落下回彈一下；1.5 秒後清掉）
export global DropFx {
    in-out property <string> key;
}

/// 任務條的出現與放開動畫：grow 從 0 長到 1（載入、切換時由左往右長出來並淡入），
/// settle 從 0 以彈簧回到 1（拖拉放開後從上面 7px 落下、稍微壓過頭再彈回）。reduce-motion 時都不播。
export component BarMotion {
    in property <string> key;
    in property <int> index;
    out property <float> grow: ListReveal.on && !Theme.reduce-motion ? 0 : 1;
    out property <float> settle: 1;
    property <bool> snap;
    public function bounce() {
        if !Theme.reduce-motion {
            snap = true;
            settle = 0;
            snap = false;
            settle = 1;
        }
    }
    init => {
        grow = 1;
        if root.key != "" && DropFx.key == root.key {
            root.bounce();
        }
    }
    animate grow {
        delay: Theme.reduce-motion ? 0ms : min(root.index, 16) * 22ms;
        duration: Theme.reduce-motion ? 0ms : 340ms;
        easing: Motion.out;
    }
    animate settle {
        duration: snap ? 0ms : Motion.spring-dur;
        easing: Motion.spring;
    }
}

/// 任務條的外觀：專案顏色的淡底＋實線邊（左邊粗），逾期是紅邊，完成的變淡，計時中前面加 ●；
/// from-before／to-after：前一週／下一週還有（那一邊不畫邊、不圓角）。
export component BarLook {
    in property <TkBar> bar;
    in property <bool> dragging;
    property <color> edge: root.bar.overdue ? Theme.error : root.bar.tint;
    opacity: root.dragging ? 0.5 : root.bar.done ? 0.55 : 1;
    Rectangle {
        background: root.bar.tint.with-alpha(0.19);
        border-width: 1px;
        border-color: root.edge;
        border-top-left-radius: root.bar.from-before ? 0px : 4px;
        border-bottom-left-radius: root.bar.from-before ? 0px : 4px;
        border-top-right-radius: root.bar.to-after ? 0px : 4px;
        border-bottom-right-radius: root.bar.to-after ? 0px : 4px;
    }
    if !root.bar.from-before: Rectangle {
        x: 0;
        width: 3px;
        background: root.edge;
        border-top-left-radius: 4px;
        border-bottom-left-radius: 4px;
    }
    HorizontalLayout {
        padding-left: root.bar.from-before ? 5px : 7px;
        padding-right: 4px;
        spacing: 0px;
        if root.bar.running: Text {
            text: "● ";
            color: Theme.run;
            font-size: 12px;
            vertical-alignment: center;
        }
        if root.bar.show-key: Text {
            text: root.bar.key + " ";
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        Text {
            text: root.bar.title;
            color: Theme.ink;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

/// 日曆、甘特圖上方的一列：‹ 今天 › 與標題，右邊放說明。
export component ScheduleToolbar {
    height: 40px;
    HorizontalLayout {
        padding-bottom: 6px;
        spacing: 4px;
        SmallButton {
            text: "‹";
            tip: TasksPageData.schedule-prev-tip;
            font-size: 14px;
            clicked => {
                TasksPageData.schedule-shift(-1);
            }
        }
        SmallButton {
            text: "今天";
            tip: "回到今天";
            clicked => {
                TasksPageData.schedule-shift(0);
            }
        }
        SmallButton {
            text: "›";
            tip: TasksPageData.schedule-next-tip;
            font-size: 14px;
            clicked => {
                TasksPageData.schedule-shift(1);
            }
        }
        Text {
            text: TasksPageData.schedule-title;
            color: Theme.ink;
            font-family: Theme.font-num;
            font-size: 17px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        Rectangle {
            width: 4px;
        }
        // 說明放不下時省略，滑過看完整
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            hint := Text {
                width: parent.width;
                height: parent.height;
                text: TasksPageData.schedule-hint;
                color: Theme.faint;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                horizontal-alignment: right;
                overflow: elide;
            }
            if hint.width < hint.preferred-width - 1px: TouchArea {
                Tooltip {
                    Tip {
                        text: TasksPageData.schedule-hint;
                        max-bubble-width: 320px;
                    }
                }
            }
        }
    }
}

/// 一條可以拖的任務條（日曆、沒有日期的清單）。day-at：滑鼠下面是哪一格（-1：日曆外）。
component CalendarBar {
    in property <TkBar> bar;
    in property <bool> undated;
    in property <int> index;
    callback day-at(length, length) -> int;
    property <bool> started;
    property <length> px;
    property <length> py;
    fx := BarMotion {
        key: root.bar.key;
        index: root.index;
    }
    BarLook {
        x: 0;
        y: (1 - fx.settle) * -7px;
        width: parent.width * fx.grow;
        height: parent.height;
        opacity: (TasksPageData.drag-key == root.bar.key ? 0.5 : root.bar.done ? 0.55 : 1) * fx.grow;
        bar: root.bar;
        dragging: TasksPageData.drag-key == root.bar.key;
    }
    menu := TaskMenuArea {
        width: parent.width;
        height: parent.height;
        key: root.bar.key;
    }
    ta := TouchArea {
        mouse-cursor: self.pressed && root.started ? MouseCursor.grabbing : MouseCursor.pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.started = false;
                root.px = self.absolute-position.x + self.mouse-x;
                root.py = self.absolute-position.y + self.mouse-y;
                TasksPageData.bar-press(root.bar.key, root.undated, root.day-at(root.px, root.py));
            } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                if root.started {
                    // 重畫後這一條落下回彈
                    DropFx.key = root.bar.key;
                    fx.bounce();
                }
                TasksPageData.bar-release(root.bar.key, root.started);
                root.started = false;
            } else if e.kind == PointerEventKind.cancel {
                root.started = false;
                TasksPageData.bar-cancel();
            } else if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
                menu.open-at({ x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y });
            }
        }
        moved => {
            if !self.pressed {
                return;
            }
            let ax = self.absolute-position.x + self.mouse-x;
            let ay = self.absolute-position.y + self.mouse-y;
            if !root.started && (abs(ax - root.px) > 4px || abs(ay - root.py) > 4px) {
                root.started = true;
            }
            if root.started {
                TasksPageData.bar-drag(root.bar.key, root.day-at(ax, ay));
            }
        }
        Tooltip {
            Tip {
                text: root.bar.tip;
                max-bubble-width: 320px;
            }
        }
    }
}

export component CalendarView {
    property <length> cell-w: weeks.width / 7;
    property <length> week-h: weeks.height / max(1, TasksPageData.cal-weeks);
    property <length> date-row: 20px;
    property <length> lane-row: 17px;
    property <length> more-x;
    property <length> more-y;
    changed height => {
        TasksPageData.cal-resized(self.height);
    }
    // 放開的回彈播完就清掉，之後的重畫不再播
    Timer {
        interval: 1500ms;
        running: DropFx.key != "";
        triggered => {
            DropFx.key = "";
        }
    }
    init => {
        TasksPageData.cal-resized(self.height);
    }
    /// 滑鼠（視窗座標）下面是哪一格；日曆外回 -1。
    function day-at(ax: length, ay: length) -> int {
        let x = ax - weeks.absolute-position.x;
        let y = ay - weeks.absolute-position.y;
        if x < 0 || y < 0 || x >= weeks.width || y >= weeks.height {
            return -1;
        }
        let col = min(6, floor(x / root.cell-w));
        let row = floor(y / root.week-h);
        return row * 7 + col;
    }
    VerticalLayout {
        ScheduleToolbar { }
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                // 星期標題
                HorizontalLayout {
                    height: 18px;
                    for w[i] in ["一", "二", "三", "四", "五", "六", "日"]: Text {
                        horizontal-stretch: 1;
                        text: w;
                        color: i >= 5 ? Theme.faint : Theme.muted;
                        font-size: Theme.fs-sm;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                }
                weeks := Rectangle {
                    vertical-stretch: 1;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Theme.line;
                    clip: true;
                    for d[i] in TasksPageData.cal-days: Rectangle {
                        x: mod(i, 7) * root.cell-w;
                        y: floor(i / 7) * root.week-h;
                        width: root.cell-w;
                        height: root.week-h;
                        background: i >= TasksPageData.cal-hl-from && i <= TasksPageData.cal-hl-to ? Theme.selected : d.in-month ? transparent : Theme.fill;
                        animate background { duration: 120ms; }
                        // 格線（右、下）
                        Rectangle {
                            x: parent.width - 1px;
                            width: 1px;
                            background: Theme.line;
                            visible: mod(i, 7) < 6;
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.line;
                        }
                        Rectangle {
                            x: 4px;
                            y: 2px;
                            height: 18px;
                            width: num.preferred-width + 12px;
                            border-radius: 9px;
                            background: d.today ? Theme.accent : transparent;
                            num := Text {
                                text: d.label;
                                font-family: Theme.font-num;
                                font-size: Theme.fs-sm;
                                font-weight: d.today ? 700 : 500;
                                color: d.today ? #FFFFFF : !d.in-month ? Theme.faint : d.weekend ? Theme.muted : Theme.ink;
                            }
                        }
                    }
                    for b[bi] in TasksPageData.cal-bars: CalendarBar {
                        index: bi;
                        x: b.column * root.cell-w + (b.from-before ? 0px : 3px);
                        y: b.week * root.week-h + root.date-row + b.lane * root.lane-row + 1px;
                        width: b.days * root.cell-w - (b.from-before ? 0px : 3px) - (b.to-after ? 1px : 4px);
                        height: root.lane-row - 2px;
                        bar: b;
                        undated: false;
                        day-at(ax, ay) => {
                            root.day-at(ax, ay)
                        }
                    }
                    // 「+N」放在任務條下面；週太矮（視窗矮）放不下時改放在日期那一行的右邊，不會疊到下一週的日期
                    for m[i] in TasksPageData.cal-more: Rectangle {
                        property <bool> tight: root.week-h < root.date-row + TasksPageData.cal-lanes * root.lane-row + 15px;
                        x: self.tight ? (m.column + 1) * root.cell-w - self.width - 3px : m.column * root.cell-w + 6px;
                        y: m.week * root.week-h + (self.tight ? 3px : root.date-row + TasksPageData.cal-lanes * root.lane-row);
                        width: more-text.preferred-width + 6px;
                        height: 15px;
                        more-text := Text {
                            x: 0;
                            text: m.text;
                            color: Theme.accent-ink;
                            font-size: 11px;
                            font-weight: 700;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.more-x = self.absolute-position.x - root.absolute-position.x;
                                root.more-y = self.absolute-position.y - root.absolute-position.y + self.height + 2px;
                                TasksPageData.cal-more-clicked(i);
                                more-popup.show();
                            }
                            Tooltip {
                                Tip {
                                    text: m.tip;
                                    max-bubble-width: 340px;
                                }
                            }
                        }
                    }
                }
            }
            // 沒有預計日期的任務：拖到日期上就設成那天
            if TasksPageData.cal-undated.length > 0: VerticalLayout {
                width: 210px;
                spacing: 2px;
                Text {
                    text: TasksPageData.cal-undated-title;
                    color: Theme.muted;
                    font-size: Theme.fs-sm;
                    font-weight: 600;
                }
                Text {
                    text: "拖到日期上就設成那天";
                    color: Theme.faint;
                    font-size: 11px;
                }
                sv := ScrollView {
                    content-height: list.preferred-height + 8px;
                    content-width: self.visible-width;
                    list := VerticalLayout {
                        width: sv.visible-width - 10px;
                        padding-top: 4px;
                        spacing: 4px;
                        for b[bi] in TasksPageData.cal-undated: CalendarBar {
                            index: bi;
                            height: 17px;
                            bar: b;
                            undated: true;
                            day-at(ax, ay) => {
                                root.day-at(ax, ay)
                            }
                        }
                    }
                }
            }
        }
    }
    more-popup := PopupWindow {
        x: root.more-x;
        y: root.more-y;
        width: 320px;
        height: min(10, TasksPageData.more-items.length) * 32px + 12px;
        close-policy: PopupClosePolicy.close-on-click-outside;
        Rectangle {
            border-radius: 14px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-color: Theme.dark ? #00000080 : #0E0F1329;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            Flickable {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                content-height: TasksPageData.more-items.length * 32px;
                for p[i] in TasksPageData.more-items: Rectangle {
                    y: i * 32px;
                    height: 32px;
                    border-radius: 9px;
                    background: pick-ta.has-hover ? Theme.fill : transparent;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: p.text;
                        color: Theme.ink;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    pick-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            more-popup.close();
                            TasksPageData.more-pick(p.key);
                        }
                    }
                }
            }
        }
    }
}
